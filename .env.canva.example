# Canva API Configuration
# https://www.canva.com/developers/

# OAuth 2.0 Credentials
CANVA_CLIENT_ID=your_client_id_here
CANVA_CLIENT_SECRET=your_client_secret_here
CANVA_REDIRECT_URI=http://localhost:3000/callback
CANVA_AUTH_CODE=your_auth_code_after_oauth_flow

# Email für OAuth
CANVA_EMAIL=berishamarius179@gmail.com

# Design Template Settings
DESIGN_TEMPLATE_WIDTH=1200
DESIGN_TEMPLATE_HEIGHT=1600
DESIGN_OUTPUT_FORMAT=png

# Farben (Quran Pattern)
COLOR_GOLD=#C9A84C
COLOR_DARK_GREEN=#0B2414
COLOR_CREAM=#F0E6C0

# Fonts
FONT_ARABIC=Scheherazade
FONT_ARABIC_SIZE=25
FONT_ARABIC_WEIGHT=bold
FONT_LATIN=Georgia
FONT_LATIN_SIZE=15

# Spacing
SPACING_PT=12

# Output
OUTPUT_DIR=./dist-alquran/Übersetzungen
OUTPUT_FORMAT=png,svg
