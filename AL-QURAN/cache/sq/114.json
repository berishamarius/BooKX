[{"verse_key":"114:1","translations":[{"text":"Thuaj: “I lutem dhe i mbështetem Zotit të njerëzve,"}]},{"verse_key":"114:2","translations":[{"text":"Sundimtarit të njerëzve,"}]},{"verse_key":"114:3","translations":[{"text":"Perëndisë së njerëzve,"}]},{"verse_key":"114:4","translations":[{"text":"nga sherri i djallit, bezdisës,"}]},{"verse_key":"114:5","translations":[{"text":"i cili fshehurazi hedh dyshime në shpirtërat e njerëzve –"}]},{"verse_key":"114:6","translations":[{"text":"prej xhindëve dhe prej njerëzve!”"}]}]