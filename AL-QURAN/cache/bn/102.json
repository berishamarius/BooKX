[{"verse_key":"102:1","translations":[{"text":"প্রাচুর্যের প্রতিযোগিতা তোমাদের মতিভ্রম ঘটায়, --"}]},{"verse_key":"102:2","translations":[{"text":"যতক্ষণ না তোমরা কবরে আসো।"}]},{"verse_key":"102:3","translations":[{"text":"না! শীঘ্রই তোমরা জানতে পারবে!"}]},{"verse_key":"102:4","translations":[{"text":"আবার বলি, -- না, শীঘ্রই তোমরা জানতে পারবে!"}]},{"verse_key":"102:5","translations":[{"text":"না, যদি তোমরা জানতে নিশ্চিত জ্ঞানে!"}]},{"verse_key":"102:6","translations":[{"text":"তোমরা তো ভয়ংকর আগুন দেখবেই।"}]},{"verse_key":"102:7","translations":[{"text":"আবার বলি, তোমরা অবশ্যই এটি দেখবে নিশ্চিত দৃষ্টিতে।"}]},{"verse_key":"102:8","translations":[{"text":"এরপর সেইদিন তোমাদের অবশ্যই জিজ্ঞাসা করা হবে অবদান সম্পর্কে।"}]}]