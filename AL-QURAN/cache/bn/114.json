[{"verse_key":"114:1","translations":[{"text":"তুমি বলে যাও -- ''আমি আশ্রয় চাইছি মানুষের প্রভুর কাছে, --"}]},{"verse_key":"114:2","translations":[{"text":"''মানুষের মালিকের, --"}]},{"verse_key":"114:3","translations":[{"text":"''মানুষের উপাস্যের,"}]},{"verse_key":"114:4","translations":[{"text":"''গোপনে আনাগোনাকারীর কুমন্ত্রণার অনিষ্ট থেকে, --"}]},{"verse_key":"114:5","translations":[{"text":"''যে মানুষের বুকের ভেতরে কুমন্ত্রণা দেয়,"}]},{"verse_key":"114:6","translations":[{"text":"''জিনের অথবা মানুষের মধ্যে থেকে।’’"}]}]