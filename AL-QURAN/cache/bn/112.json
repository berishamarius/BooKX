[{"verse_key":"112:1","translations":[{"text":"তুমি বলো -- ''তিনি আল্লাহ্‌, একক-অদ্বিতীয়;"}]},{"verse_key":"112:2","translations":[{"text":"''আল্লাহ্ -- পরম নির্ভরস্থল।"}]},{"verse_key":"112:3","translations":[{"text":"''তিনি জন্ম দেন না, এবং জন্ম নেনও নি,"}]},{"verse_key":"112:4","translations":[{"text":"''এবং কেউই তাঁর সমতুল্য হতে পারে না।’’"}]}]