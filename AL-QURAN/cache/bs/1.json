[{"verse_key":"1:1","translations":[{"text":"U ime Boga, Milostivog, Samilosnog!"}]},{"verse_key":"1:2","translations":[{"text":"Tebe, Boga, Gospodara svjetova, hvalimo,"}]},{"verse_key":"1:3","translations":[{"text":"Milostivog, Samilosnog,"}]},{"verse_key":"1:4","translations":[{"text":"Vladara Dana sudnjeg,"}]},{"verse_key":"1:5","translations":[{"text":"Tebi se klanjamo i od Tebe pomoć tražimo!"}]},{"verse_key":"1:6","translations":[{"text":"Uputi nas na Pravi put,"}]},{"verse_key":"1:7","translations":[{"text":"na Put onih kojima si milost Svoju darovao, a ne onih koji su protiv sebe srdžbu izazvali, niti onih koji su zalutali!"}]}]