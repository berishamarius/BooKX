[{"verse_key":"101:1","translations":[{"text":"Smak svijeta!"}]},{"verse_key":"101:2","translations":[{"text":"Šta je Smak svijeta?"}]},{"verse_key":"101:3","translations":[{"text":"i šta ti znaš o Smaku svijeta?"}]},{"verse_key":"101:4","translations":[{"text":"Toga dana će ljudi biti kao leptiri raštrkani,"}]},{"verse_key":"101:5","translations":[{"text":"a planine kao šarena vuna iščupanā."}]},{"verse_key":"101:6","translations":[{"text":"Onaj u koga njegova djela budu teška –"}]},{"verse_key":"101:7","translations":[{"text":"u ugodnu životu će živjeti,"}]},{"verse_key":"101:8","translations":[{"text":"a onaj u koga njegova djela budu lahka –"}]},{"verse_key":"101:9","translations":[{"text":"boravište će mu bezdan biti."}]},{"verse_key":"101:10","translations":[{"text":"A znaš li ti šta će to biti? –"}]},{"verse_key":"101:11","translations":[{"text":"Vatra užarena!"}]}]