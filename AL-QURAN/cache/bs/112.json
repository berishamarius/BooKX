[{"verse_key":"112:1","translations":[{"text":"Reci: \"On je Bog – Jedan!"}]},{"verse_key":"112:2","translations":[{"text":"Bog je Utočište svakom!"}]},{"verse_key":"112:3","translations":[{"text":"Nije rodio i rođen nije,"}]},{"verse_key":"112:4","translations":[{"text":"i niko Mu ravan nije!\""}]}]