[{"verse_key":"104:1","translations":[{"text":"Teško svakom klevetniku-podrugljivcu,"}]},{"verse_key":"104:2","translations":[{"text":"koji blago gomila i prebrojava ga,"}]},{"verse_key":"104:3","translations":[{"text":"i misli da će ga blago njegovo besmrtnim učiniti!"}]},{"verse_key":"104:4","translations":[{"text":"A ne valja tako! On će, sigurno, biti bačen u Džehennem!"}]},{"verse_key":"104:5","translations":[{"text":"A znaš li ti šta je Džehennem?"}]},{"verse_key":"104:6","translations":[{"text":"Vatra Allahova razbuktana,"}]},{"verse_key":"104:7","translations":[{"text":"koja će do srcā dopirati."}]},{"verse_key":"104:8","translations":[{"text":"Ona će iznad njih biti zatvorena,"}]},{"verse_key":"104:9","translations":[{"text":"plamenim stupovima zasvođena."}]}]