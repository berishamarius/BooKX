[{"verse_key":"114:1","translations":[{"text":"Reci: \"Tražim zaštitu Gospodara ljudi,"}]},{"verse_key":"114:2","translations":[{"text":"Vladara ljudi,"}]},{"verse_key":"114:3","translations":[{"text":"Boga ljudi,"}]},{"verse_key":"114:4","translations":[{"text":"od zla šejtana-napasnika,"}]},{"verse_key":"114:5","translations":[{"text":"koji zle misli unosi u srca ljudi –"}]},{"verse_key":"114:6","translations":[{"text":"od džina i od ljudi!\""}]}]