[{"verse_key":"112:1","translations":[{"text":"(ऐ रसूल) तुम कह दो कि ख़ुदा एक है"}]},{"verse_key":"112:2","translations":[{"text":"ख़ुदा बरहक़ बेनियाज़ है"}]},{"verse_key":"112:3","translations":[{"text":"न उसने किसी को जना न उसको किसी ने जना,"}]},{"verse_key":"112:4","translations":[{"text":"और उसका कोई हमसर नहीं"}]}]