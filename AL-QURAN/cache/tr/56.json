[{"verse_key":"56:1","translations":[{"text":"Olacak vak'a olduğu zaman"}]},{"verse_key":"56:2","translations":[{"text":"Onun oluşunu yalanlayacak kimse yoktur."}]},{"verse_key":"56:3","translations":[{"text":"O, alçaltıcıdır, yükselticidir."}]},{"verse_key":"56:4","translations":[{"text":"Yer şiddetle sarsıldığı"}]},{"verse_key":"56:5","translations":[{"text":"Dağlar serpildikçe serpildiği"}]},{"verse_key":"56:6","translations":[{"text":"Dağılıp toz duman haline geldiği"}]},{"verse_key":"56:7","translations":[{"text":"Ve sizler üç sınıf olduğunuz zaman"}]},{"verse_key":"56:8","translations":[{"text":"Sağın adamları (var ya) ne mutludurlar onlar!"}]},{"verse_key":"56:9","translations":[{"text":"Solun adamları ise ne uğursuzdurlar onlar!"}]},{"verse_key":"56:10","translations":[{"text":"Önde olanlar (var ya), onlar öncüdürler."}]},{"verse_key":"56:11","translations":[{"text":"İşte o yaklaştırılanlar,"}]},{"verse_key":"56:12","translations":[{"text":"Nimet cennetlerindedirler."}]},{"verse_key":"56:13","translations":[{"text":"Çoğu önceki ümmetlerden,"}]},{"verse_key":"56:14","translations":[{"text":"Birazı da sonrakilerden."}]},{"verse_key":"56:15","translations":[{"text":"(Onlar) cevherlerle işlenmiş tahtlar üzerindedirler."}]},{"verse_key":"56:16","translations":[{"text":"Karşılıklı olarak onların üzerinde yaslanırlar."}]},{"verse_key":"56:17","translations":[{"text":"Çevrelerinde, ölümsüzlüğe ulaşmış gençler dolaşırlar."}]},{"verse_key":"56:18","translations":[{"text":"Kaynağından doldurulmuş, testiler, ibrikler ve kadehlerle."}]},{"verse_key":"56:19","translations":[{"text":"Ondan ne başları ağrıtılır, ne de akılları giderilir."}]},{"verse_key":"56:20","translations":[{"text":"Beğendikleri meyvalar,"}]},{"verse_key":"56:21","translations":[{"text":"Canlarının çektiği kuş etleri,"}]},{"verse_key":"56:22","translations":[{"text":"İri gözlü hûriler,"}]},{"verse_key":"56:23","translations":[{"text":"Saklı inciler gibi,"}]},{"verse_key":"56:24","translations":[{"text":"Yaptıklarına karşılık olarak verilir."}]},{"verse_key":"56:25","translations":[{"text":"Orada boş bir söz ve günaha sokan bir laf işitmezler."}]},{"verse_key":"56:26","translations":[{"text":"Duydukları söz, yalnız \"selam\", \"selam\" dır."}]},{"verse_key":"56:27","translations":[{"text":"Sağın adamları, nedir o sağın adamları!"}]},{"verse_key":"56:28","translations":[{"text":"Dalbastı kirazlar,"}]},{"verse_key":"56:29","translations":[{"text":"Meyva dizili muzlar,"}]},{"verse_key":"56:30","translations":[{"text":"Uzamış gölgeler,"}]},{"verse_key":"56:31","translations":[{"text":"Fışkıran sular."}]},{"verse_key":"56:32","translations":[{"text":"Pek çok meyva arasında,"}]},{"verse_key":"56:33","translations":[{"text":"Tükenmeyen ve yasaklanmayan"}]},{"verse_key":"56:34","translations":[{"text":"Ve yükseltilmiş döşekler üstündedirler."}]},{"verse_key":"56:35","translations":[{"text":"Biz kadınları yeniden inşa ettik (yarattık)."}]},{"verse_key":"56:36","translations":[{"text":"Onları bâkireler yaptık."}]},{"verse_key":"56:37","translations":[{"text":"Hep yaşıt sevgililer,"}]},{"verse_key":"56:38","translations":[{"text":"Sağın adamları içindir."}]},{"verse_key":"56:39","translations":[{"text":"Bir çoğu öncekilerdendir."}]},{"verse_key":"56:40","translations":[{"text":"Bir çoğu da sonrakilerdendir."}]},{"verse_key":"56:41","translations":[{"text":"Solun adamları, nedir o solcular!"}]},{"verse_key":"56:42","translations":[{"text":"İçlerine işleyen bir ateş ve kaynar şu içinde,"}]},{"verse_key":"56:43","translations":[{"text":"Kapkara dumandan bir gölge altındadırlar."}]},{"verse_key":"56:44","translations":[{"text":"Ki ne serindir, ne de faydalı."}]},{"verse_key":"56:45","translations":[{"text":"Çünkü onlar bundan önce varlık içinde sefâhete dalmışlardı."}]},{"verse_key":"56:46","translations":[{"text":"Büyük günahı işlemekte ısrar ediyorlardı."}]},{"verse_key":"56:47","translations":[{"text":"Ve diyorlardı ki: \"Biz ölüp, toprak ve kemik yığını olduktan sonra, biz mi bir daha diriltileceğiz?\""}]},{"verse_key":"56:48","translations":[{"text":"\"Önceki atalarımızda mı?\""}]},{"verse_key":"56:49","translations":[{"text":"De ki: \"Öncekiler ve sonrakiler\""}]},{"verse_key":"56:50","translations":[{"text":"\"Belli bir günün belli vaktinde mutlaka toplanacaklardır.\""}]},{"verse_key":"56:51","translations":[{"text":"Sonra siz, ey sapık yalanlayıcılar!"}]},{"verse_key":"56:52","translations":[{"text":"Elbette bir ağaçtan, zakkum ağacından yiyeceksiniz."}]},{"verse_key":"56:53","translations":[{"text":"Karınlarınızı hep onunla dolduracaksınız."}]},{"verse_key":"56:54","translations":[{"text":"Üstüne de kaynar su içeceksiniz."}]},{"verse_key":"56:55","translations":[{"text":"Susuzluk illetine tutulmuş develerin içişi gibi içeceksiniz."}]},{"verse_key":"56:56","translations":[{"text":"İşte ceza gününde onlara sunulacak ziyafet budur."}]},{"verse_key":"56:57","translations":[{"text":"Biz sizi yarattık; tasdik etmeniz gerekmez mi?"}]},{"verse_key":"56:58","translations":[{"text":"Attığınız meniyi gördünüz mü?"}]},{"verse_key":"56:59","translations":[{"text":"Onu siz mi yaratıyorsunuz yoksa yaratan biz miyiz?"}]},{"verse_key":"56:60","translations":[{"text":"Aranızda ölümü takdir eden biziz ve bizim önümüze geçilmez."}]},{"verse_key":"56:61","translations":[{"text":"Böylece sizin yerinize benzerlerinizi getirelim ve sizi bilmediğiniz bir yaratılışta tekrar var edelim diye (böyle yapıyoruz)."}]},{"verse_key":"56:62","translations":[{"text":"Andolsun, ilk yaratılışı bildiniz. Düşünüp ibret almanız gerekmez mi?"}]},{"verse_key":"56:63","translations":[{"text":"Ektiğinizi gördünüz mü?"}]},{"verse_key":"56:64","translations":[{"text":"Onu siz mi bitiriyorsunuz, yoksa bitiren biz miyiz?"}]},{"verse_key":"56:65","translations":[{"text":"Dileseydik, onu kuru bir çöp yapardık. Hayret eder dururdunuz."}]},{"verse_key":"56:66","translations":[{"text":"\"Doğrusu borç altına girdik.\""}]},{"verse_key":"56:67","translations":[{"text":"\"Doğrusu, biz yoksul bırakıldık\" (derdiniz)."}]},{"verse_key":"56:68","translations":[{"text":"İçtiğiniz suya baktınız mı?"}]},{"verse_key":"56:69","translations":[{"text":"Buluttan onu siz mi indirdiniz, yoksa indiren biz miyiz?"}]},{"verse_key":"56:70","translations":[{"text":"Dileseydik onu tuzlu yapardık. O halde şükretseniz ya!"}]},{"verse_key":"56:71","translations":[{"text":"Yaktığınız ateşi gördünüz mü?"}]},{"verse_key":"56:72","translations":[{"text":"Onun ağacını siz mi yarattınız, yoksa yaratan biz miyiz?"}]},{"verse_key":"56:73","translations":[{"text":"Biz onu bir ibret ve çölden gelip geçenlere bir fayda yaptık."}]},{"verse_key":"56:74","translations":[{"text":"Öyleyse büyük Rabbinin adını yücelt."}]},{"verse_key":"56:75","translations":[{"text":"Hayır, yıldızların yerlerine yemin ederim."}]},{"verse_key":"56:76","translations":[{"text":"Bilirseniz bu büyük bir yemindir."}]},{"verse_key":"56:77","translations":[{"text":"O, elbette şerefli bir Kur'ân'dır."}]},{"verse_key":"56:78","translations":[{"text":"Korunmuş bir kitaptadır."}]},{"verse_key":"56:79","translations":[{"text":"Ona temizlenenlerden başkası el süremez."}]},{"verse_key":"56:80","translations":[{"text":"(O), âlemlerin Rabbinden indirilmiştir."}]},{"verse_key":"56:81","translations":[{"text":"Şimdi siz bu sözü mü küçümsüyorsunuz?"}]},{"verse_key":"56:82","translations":[{"text":"Rızkınızı, yalanlamanızdan ibaret mi kılıyorsunuz?"}]},{"verse_key":"56:83","translations":[{"text":"Can boğaza dayandığı zaman"}]},{"verse_key":"56:84","translations":[{"text":"Ki o zaman siz (ölmek üzere olana) bakar durursunuz."}]},{"verse_key":"56:85","translations":[{"text":"Biz ona sizden daha yakınız, fakat siz görmezsiniz."}]},{"verse_key":"56:86","translations":[{"text":"Eğer cezalandırılmayacak iseniz,"}]},{"verse_key":"56:87","translations":[{"text":"Onu geri çevirsenize; şayet iddianızda doğru iseniz."}]},{"verse_key":"56:88","translations":[{"text":"Fakat ölen kişiye gelince, eğer o rahmete yaklaştırılanlardan ise,"}]},{"verse_key":"56:89","translations":[{"text":"Ona rahatlık, güzel rızık ve Naîm cenneti vardır."}]},{"verse_key":"56:90","translations":[{"text":"Eğer O, sağın adamlarından ise,"}]},{"verse_key":"56:91","translations":[{"text":"\"(Ey sağcı), sana sağcılardan selam!\""}]},{"verse_key":"56:92","translations":[{"text":"Ama yalanlayıcı sapıklardan ise;"}]},{"verse_key":"56:93","translations":[{"text":"İşte ona da kaynar sudan bir ziyafet vardır."}]},{"verse_key":"56:94","translations":[{"text":"Ve cehenneme atılma vardır."}]},{"verse_key":"56:95","translations":[{"text":"Kesin gerçek budur işte."}]},{"verse_key":"56:96","translations":[{"text":"Öyle ise Rabbini o büyük ismiyle tesbih et."}]}]