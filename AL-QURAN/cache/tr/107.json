[{"verse_key":"107:1","translations":[{"text":"Dini yalanlayanı gördün mü?"}]},{"verse_key":"107:2","translations":[{"text":"İşte o, öksüzü iter, kakar."}]},{"verse_key":"107:3","translations":[{"text":"Yoksulu doyurmaya önayak olmaz."}]},{"verse_key":"107:4","translations":[{"text":"Vay haline o namaz kılanların ki,"}]},{"verse_key":"107:5","translations":[{"text":"Kıldıkları namazın değerine aldırış etmezler."}]},{"verse_key":"107:6","translations":[{"text":"Gösteriş yaparlar onlar,"}]},{"verse_key":"107:7","translations":[{"text":"Ve yardımlığı sakınırlar (zekatı vermezler)."}]}]