[{"verse_key":"91:1","translations":[{"text":"Güneş'e ve onun parıltısına,"}]},{"verse_key":"91:2","translations":[{"text":"Güneş'in ardından gelen Ay'a,"}]},{"verse_key":"91:3","translations":[{"text":"Güneş'i açıp ortaya çıkaran gündüze,"}]},{"verse_key":"91:4","translations":[{"text":"Onu örten geceye,"}]},{"verse_key":"91:5","translations":[{"text":"Göğe ve onu bina edene,"}]},{"verse_key":"91:6","translations":[{"text":"Yere ve onu döşeyene,"}]},{"verse_key":"91:7","translations":[{"text":"Nefse ve onu biçimlendirene,"}]},{"verse_key":"91:8","translations":[{"text":"Sonra da ona kötülük ve takva kabiliyetini verene yemin olsun ki,"}]},{"verse_key":"91:9","translations":[{"text":"Elbette nefsini temizleyip parlatan kurtulmuştur."}]},{"verse_key":"91:10","translations":[{"text":"Onu kirletip gömen de ziyan etmiştir."}]},{"verse_key":"91:11","translations":[{"text":"Semud, azgınlığıyla Hakk'ı yalanladı,"}]},{"verse_key":"91:12","translations":[{"text":"En azgınları ileri atılınca,"}]},{"verse_key":"91:13","translations":[{"text":"Allah'ın Rasulü (Salih Allah'ın elçisi) onlara: \"Allah'ın devesini ve onun su nöbetini gözetin.\" demişti."}]},{"verse_key":"91:14","translations":[{"text":"Fakat onlar peygamberi yalanlayıp deveyi kestiler. Rableri de günahlarını başlarına geçiriverdi de orayı dümdüz etti."}]},{"verse_key":"91:15","translations":[{"text":"Öyle ya, Allah bu işin sonundan korkacak değil ya."}]}]