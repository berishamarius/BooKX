[{"verse_key":"87:1","translations":[{"text":"Rabbinin yüce adını tesbih et."}]},{"verse_key":"87:2","translations":[{"text":"Yaratıp düzene koyan O'dur."}]},{"verse_key":"87:3","translations":[{"text":"Takdir edip hidayeti gösteren O'dur."}]},{"verse_key":"87:4","translations":[{"text":"Otlağı çıkaran,"}]},{"verse_key":"87:5","translations":[{"text":"Sonra da onu karamsı bir sel köpüğü haline getiren O'dur."}]},{"verse_key":"87:6","translations":[{"text":"Bundan böyle sana Kur'ân'ı okutacağız da unutmayacaksın."}]},{"verse_key":"87:7","translations":[{"text":"Yalnız Allah'ın dilediği başkadır. Çünkü o açığı da bilir, gizliyi de."}]},{"verse_key":"87:8","translations":[{"text":"Seni en kolay yola muvaffak kılacağız."}]},{"verse_key":"87:9","translations":[{"text":"Onun için öğüt ver, eğer öğüt fayda verirse."}]},{"verse_key":"87:10","translations":[{"text":"Saygısı olan öğüt alacaktır."}]},{"verse_key":"87:11","translations":[{"text":"Pek bedbaht olan da ondan kaçınacaktır."}]},{"verse_key":"87:12","translations":[{"text":"O ki, en büyük ateşe girecektir."}]},{"verse_key":"87:13","translations":[{"text":"Sonra ne ölecek onda, ne de hayat bulacaktır."}]},{"verse_key":"87:14","translations":[{"text":"Doğrusu felah buldu (günahtan) temizlenen."}]},{"verse_key":"87:15","translations":[{"text":"Rabbinin adını anıp namaz kılan."}]},{"verse_key":"87:16","translations":[{"text":"Fakat siz dünya hayatını tercih ediyorsunuz."}]},{"verse_key":"87:17","translations":[{"text":"Oysa ahiret daha hayırlı ve daha kalıcıdır."}]},{"verse_key":"87:18","translations":[{"text":"Kuşkusuz bu ilk sahifelerde vardır,"}]},{"verse_key":"87:19","translations":[{"text":"İbrahim ve Musa'nın sahifelerinde."}]}]