[{"verse_key":"114:1","translations":[{"text":"De ki: Sığınırım ben insanların Rabbine,"}]},{"verse_key":"114:2","translations":[{"text":"İnsanların hükümdârına,"}]},{"verse_key":"114:3","translations":[{"text":"İnsanların ilâhına,"}]},{"verse_key":"114:4","translations":[{"text":"O sinsi vesvesecinin şerrinden."}]},{"verse_key":"114:5","translations":[{"text":"O ki, insanların göğüslerine vesveseler fısıldar."}]},{"verse_key":"114:6","translations":[{"text":"Gerek cinlerden, gerek insanlardan."}]}]