[{"verse_key":"82:1","translations":[{"text":"Gök çatladığı vakit,"}]},{"verse_key":"82:2","translations":[{"text":"Yıldızlar döküldüğü vakit,"}]},{"verse_key":"82:3","translations":[{"text":"Denizler yarılıp akıtıldığı vakit,"}]},{"verse_key":"82:4","translations":[{"text":"Kabirlerin içi dışına getirildiği vakit,"}]},{"verse_key":"82:5","translations":[{"text":"Herkes neyi önünden gönderdiğini ve neyi geri bıraktığını bilir."}]},{"verse_key":"82:6","translations":[{"text":"Ey insan! İhsanı bol Rabb'ine karşı seni aldatan nedir?"}]},{"verse_key":"82:7","translations":[{"text":"O Allah ki seni yarattı, seni düzgün yapılı kılıp ölçülü bir biçim verdi."}]},{"verse_key":"82:8","translations":[{"text":"Seni dilediği her hangi bir şekilde parçalardan oluşturdu."}]},{"verse_key":"82:9","translations":[{"text":"Hayır hayır, siz cezayı yalanlıyorsunuz."}]},{"verse_key":"82:10","translations":[{"text":"Oysa üzerinizde koruyucular var."}]},{"verse_key":"82:11","translations":[{"text":"Değerli yazıcılar"}]},{"verse_key":"82:12","translations":[{"text":"Onlar, siz her ne yaparsanız bilirler"}]},{"verse_key":"82:13","translations":[{"text":"Kuşkusuz iyiler nimet içindedirler."}]},{"verse_key":"82:14","translations":[{"text":"Kötüler de cehennemdedirler."}]},{"verse_key":"82:15","translations":[{"text":"Ceza günü ona girecekler."}]},{"verse_key":"82:16","translations":[{"text":"Onlar o cehennemin gözünden kaçamazlar."}]},{"verse_key":"82:17","translations":[{"text":"Ceza gününün ne olduğunu sen bilir misin?"}]},{"verse_key":"82:18","translations":[{"text":"Evet, bilir misin nedir acaba o ceza günü?"}]},{"verse_key":"82:19","translations":[{"text":"O gün, hiç kimsenin başkası için hiçbir şeye sahip olamadığı gündür. O gün buyruk yalnız Allah'ındır."}]}]