[{"verse_key":"84:1","translations":[{"text":"Gök yarıldığı,"}]},{"verse_key":"84:2","translations":[{"text":"Rabbini dinleyip kendisine yaraşır şekilde boyun eğdiği vakit,"}]},{"verse_key":"84:3","translations":[{"text":"Yer uzatılıp düzlendiği,"}]},{"verse_key":"84:4","translations":[{"text":"İçinde ne varsa attığı ve tamamen boşaldığı"}]},{"verse_key":"84:5","translations":[{"text":"Ve Rabbini dinleyip kendisine yaraşır şekilde boyun eğdiği vakit,"}]},{"verse_key":"84:6","translations":[{"text":"Ey insan! Kuşkusuz sen Rabbine doğru çaba üstüne çaba sarfetmektesin, nihayet O'na varacaksın."}]},{"verse_key":"84:7","translations":[{"text":"O vakit kitabı sağ eline verilen,"}]},{"verse_key":"84:8","translations":[{"text":"Kolay bir hesapla hesaba çekilecek,"}]},{"verse_key":"84:9","translations":[{"text":"Ve sevinçli olarak ailesine dönecektir."}]},{"verse_key":"84:10","translations":[{"text":"Ama kitabı arkasından verilen,"}]},{"verse_key":"84:11","translations":[{"text":"\"Yetiş ey ölüm!\" diye bağıracak"}]},{"verse_key":"84:12","translations":[{"text":"Ve alevli ateşe girecektir."}]},{"verse_key":"84:13","translations":[{"text":"Çünkü o ailesi içinde sevinçli idi."}]},{"verse_key":"84:14","translations":[{"text":"Hiç Rabbine dönmeyeceğini sanmıştı."}]},{"verse_key":"84:15","translations":[{"text":"Hayır Rabbi onu görmekte idi."}]},{"verse_key":"84:16","translations":[{"text":"Şimdi, yemin ederim o şafağa,"}]},{"verse_key":"84:17","translations":[{"text":"Geceye ve içinde barındırdığı şeylere,"}]},{"verse_key":"84:18","translations":[{"text":"Derlendiği zaman o aya,"}]},{"verse_key":"84:19","translations":[{"text":"Ki, siz elbette halden hale geçeceksiniz."}]},{"verse_key":"84:20","translations":[{"text":"Böyleyken onlar neden acaba iman etmezler?"}]},{"verse_key":"84:21","translations":[{"text":"Karşılarında Kur'ân okunduğu vakit secde etmezler?"}]},{"verse_key":"84:22","translations":[{"text":"Aksine o nankörler yalanlıyorlar."}]},{"verse_key":"84:23","translations":[{"text":"Oysa Allah içlerinde sakladıklarını biliyor."}]},{"verse_key":"84:24","translations":[{"text":"Onun için onlara elem verici bir azabı müjdele."}]},{"verse_key":"84:25","translations":[{"text":"Ancak iman edip iyi ameller işleyenler başkadır. Onlara tükenmez bir ecir vardır."}]}]