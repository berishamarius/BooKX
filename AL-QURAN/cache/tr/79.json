[{"verse_key":"79:1","translations":[{"text":"Andolsun şiddetle çekip çıkaranlara,"}]},{"verse_key":"79:2","translations":[{"text":"Usulcacık çekenlere,"}]},{"verse_key":"79:3","translations":[{"text":"Yüzüp yüzüp gidenlere,"}]},{"verse_key":"79:4","translations":[{"text":"Yarışıp geçenlere,"}]},{"verse_key":"79:5","translations":[{"text":"Derken bir iş çevirenlere kasem olsun (ki kıyamet var)."}]},{"verse_key":"79:6","translations":[{"text":"O gün deprem sarsar,"}]},{"verse_key":"79:7","translations":[{"text":"Onu ikinci bir sarsıntı izler."}]},{"verse_key":"79:8","translations":[{"text":"Yürekler vardır, o gün kaygıdan hoplar."}]},{"verse_key":"79:9","translations":[{"text":"Gözler kalkmaz saygıdan."}]},{"verse_key":"79:10","translations":[{"text":"Diyorlar ki: \"Biz tekrar eski halimize mi döndürülecekmişiz?"}]},{"verse_key":"79:11","translations":[{"text":"\"Biz, çürümüş kemikler olduktan sonra ha?\""}]},{"verse_key":"79:12","translations":[{"text":"\"Öyleyse bu çok zararlı bir dönüştür.\" dediler."}]},{"verse_key":"79:13","translations":[{"text":"Fakat o bir tek haykırıştır."}]},{"verse_key":"79:14","translations":[{"text":"Bir de bakarsın hepsi meydandadır."}]},{"verse_key":"79:15","translations":[{"text":"Musa'nın haberi sana geldi mi?"}]},{"verse_key":"79:16","translations":[{"text":"Hani Rabbi ona kutsal vaadi Tuva'da seslenmişti:"}]},{"verse_key":"79:17","translations":[{"text":"\"Haydi, demişti, git Firavun'a, çünkü o çok azdı.\""}]},{"verse_key":"79:18","translations":[{"text":"De ki: İster misin arınasın?"}]},{"verse_key":"79:19","translations":[{"text":"Seni Rabbinin yoluna ileteyim de ondan korkasın."}]},{"verse_key":"79:20","translations":[{"text":"Musa Firavun'a o büyük mucizeyi gösterdi."}]},{"verse_key":"79:21","translations":[{"text":"Fakat Firavun yalanladı, karşı geldi."}]},{"verse_key":"79:22","translations":[{"text":"Sonra koşarak dönüp gitti."}]},{"verse_key":"79:23","translations":[{"text":"Derken adamlarını topladı da bağırdı:"}]},{"verse_key":"79:24","translations":[{"text":"\"Ben sizin en yüce Rabbinizim\" dedi."}]},{"verse_key":"79:25","translations":[{"text":"Allah da onu tuttu, dünya ve ahiret azabıyla yakalayıverdi."}]},{"verse_key":"79:26","translations":[{"text":"Kuşkusuz bunda, saygı duyacaklar için bir ibret vardır."}]},{"verse_key":"79:27","translations":[{"text":"Yaratılışça siz mi daha çetinsiniz, yoksa gök mü? Onu Allah bina etti."}]},{"verse_key":"79:28","translations":[{"text":"Tavanını yükseltti, onu bir düzene koydu."}]},{"verse_key":"79:29","translations":[{"text":"Gecesini kararttı, kuşluğunu çıkardı."}]},{"verse_key":"79:30","translations":[{"text":"Bundan sonra da yeryüzünü döşedi."}]},{"verse_key":"79:31","translations":[{"text":"Ondan suyunu ve otlağını çıkardı."}]},{"verse_key":"79:32","translations":[{"text":"Dağlarını oturttu."}]},{"verse_key":"79:33","translations":[{"text":"Sizin ve hayvanlarınızın geçimi için."}]},{"verse_key":"79:34","translations":[{"text":"Fakat o her şeyi bastıran büyük felaket geldiği vakit,"}]},{"verse_key":"79:35","translations":[{"text":"O, insanın neyin peşinde koştuğunu anladığı gün,"}]},{"verse_key":"79:36","translations":[{"text":"Gören kimseler için ebedi ateş hortlatıldığı vakit,"}]},{"verse_key":"79:37","translations":[{"text":"Artık her kim azgınlık etmiş,"}]},{"verse_key":"79:38","translations":[{"text":"Ve dünya hayatını tercih etmişse,"}]},{"verse_key":"79:39","translations":[{"text":"Kuşkusuz onun varacağı yer cehennemdir."}]},{"verse_key":"79:40","translations":[{"text":"Kim de Rabbinin divanında durmaktan korkmuş, nefsini boş heveslerden menetmiş ise,"}]},{"verse_key":"79:41","translations":[{"text":"Kuşkusuz onun varacağı yer cennettir."}]},{"verse_key":"79:42","translations":[{"text":"Sana o kıyameti soruyorlar, ne zaman kopacak diye."}]},{"verse_key":"79:43","translations":[{"text":"Sen nerde, onu anlatmak nerde?!"}]},{"verse_key":"79:44","translations":[{"text":"Onun son ilmi Rabbine aittir."}]},{"verse_key":"79:45","translations":[{"text":"Sen ancak ondan korkacak olanları uyarıcısın."}]},{"verse_key":"79:46","translations":[{"text":"Onlar o kıyameti görecekleri gün sanki dünyada bir akşam veya kuşluğundan başka durmamışa dönecekler."}]}]