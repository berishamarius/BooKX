[{"verse_key":"113:1","translations":[{"text":"De ki: \"Ben, ağaran sabahın Rabbine sığınırım,"}]},{"verse_key":"113:2","translations":[{"text":"Yarattığı şeylerin şerrinden,"}]},{"verse_key":"113:3","translations":[{"text":"Karanlığı çöktüğü zaman gecenin şerrinden,"}]},{"verse_key":"113:4","translations":[{"text":"Ve düğümlere üfleyen büyücülerin şerrinden,"}]},{"verse_key":"113:5","translations":[{"text":"Ve hased ettiği zaman hasetçinin şerrinden."}]}]