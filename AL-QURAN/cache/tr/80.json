[{"verse_key":"80:1","translations":[{"text":"(Peygamber) Yüzünü ekşitti ve döndü."}]},{"verse_key":"80:2","translations":[{"text":"Kendisine âmâ geldi, diye."}]},{"verse_key":"80:3","translations":[{"text":"Ne bilirsin, belki o temizlenecek?"}]},{"verse_key":"80:4","translations":[{"text":"Veya öğüt belleyecek de öğüt ona fayda verecek."}]},{"verse_key":"80:5","translations":[{"text":"Ama buna ihtiyaç hissetmeyene gelince,"}]},{"verse_key":"80:6","translations":[{"text":"Sen ona yöneliyorsun."}]},{"verse_key":"80:7","translations":[{"text":"Onun temizlenmemesinden sana ne?"}]},{"verse_key":"80:8","translations":[{"text":"Ama sana can atarak gelen,"}]},{"verse_key":"80:9","translations":[{"text":"Allah'tan korkarak gelmişken,"}]},{"verse_key":"80:10","translations":[{"text":"Sen onunla ilgilenmiyorsun."}]},{"verse_key":"80:11","translations":[{"text":"Hayır hayır, sakın. Çünkü o Kur'ân bir öğüttür."}]},{"verse_key":"80:12","translations":[{"text":"Artık dileyen onu düşünür."}]},{"verse_key":"80:13","translations":[{"text":"O, değerli sahifelerdedir."}]},{"verse_key":"80:14","translations":[{"text":"Yüksek tutulan tertemiz sahifelerde."}]},{"verse_key":"80:15","translations":[{"text":"Yazıcıların ellerindedir,"}]},{"verse_key":"80:16","translations":[{"text":"Değerli, iyi yazıcıların."}]},{"verse_key":"80:17","translations":[{"text":"O kahrolası insan, ne nankör şey."}]},{"verse_key":"80:18","translations":[{"text":"O yaratan onu hangi şeyden yarattı?"}]},{"verse_key":"80:19","translations":[{"text":"Bir damla sudan, onu yarattı da biçime koydu."}]},{"verse_key":"80:20","translations":[{"text":"Sonra ona yolunu kolaylaştırdı."}]},{"verse_key":"80:21","translations":[{"text":"Sonra onu öldürdü de kabre koydurdu."}]},{"verse_key":"80:22","translations":[{"text":"Sonra dilediği vakit onu tekrar diriltir."}]},{"verse_key":"80:23","translations":[{"text":"Hayır hayır, doğrusu o, hiç Allah'ın emrini tam yerine getirmedi,"}]},{"verse_key":"80:24","translations":[{"text":"Bir de o insan yiyeceğine baksın."}]},{"verse_key":"80:25","translations":[{"text":"Biz o suyu bol bol döktük."}]},{"verse_key":"80:26","translations":[{"text":"Sonra toprağı nasıl da yardık."}]},{"verse_key":"80:27","translations":[{"text":"Bu suretle orada ekinler bitirdik."}]},{"verse_key":"80:28","translations":[{"text":"Üzümler, yoncalar,"}]},{"verse_key":"80:29","translations":[{"text":"Zeytinlikler, hurmalıklar,"}]},{"verse_key":"80:30","translations":[{"text":"İri ve sık ağaçlı bahçeler,"}]},{"verse_key":"80:31","translations":[{"text":"Meyveler, çayırlar bitirdik."}]},{"verse_key":"80:32","translations":[{"text":"Siz ve hayvanlarınız faydalansın diye."}]},{"verse_key":"80:33","translations":[{"text":"Kulakları sağır eden o gürültü geldiğinde,"}]},{"verse_key":"80:34","translations":[{"text":"O gün kişi kaçar, kardeşinden..."}]},{"verse_key":"80:35","translations":[{"text":"Anasından, babasından.."}]},{"verse_key":"80:36","translations":[{"text":"Eşinden ve oğullarından."}]},{"verse_key":"80:37","translations":[{"text":"Onlardan her birinin o gün başından aşan işi vardır."}]},{"verse_key":"80:38","translations":[{"text":"Yüzler var ki, o gün parıl parıl,"}]},{"verse_key":"80:39","translations":[{"text":"Güler, sevinir."}]},{"verse_key":"80:40","translations":[{"text":"Yüzler de var ki, o gün tozlanmış,"}]},{"verse_key":"80:41","translations":[{"text":"Onları karanlık bürümüş,"}]},{"verse_key":"80:42","translations":[{"text":"İşte onlardır hakikati reddedip inkâr edenler, haktan sapanlar."}]}]