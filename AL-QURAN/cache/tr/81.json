[{"verse_key":"81:1","translations":[{"text":"Güneş katlanıp dürüldüğünde,"}]},{"verse_key":"81:2","translations":[{"text":"Yıldızlar bulandığında,"}]},{"verse_key":"81:3","translations":[{"text":"Dağlar yürütüldüğünde,"}]},{"verse_key":"81:4","translations":[{"text":"Kıyılmaz mallar bırakıldığında,"}]},{"verse_key":"81:5","translations":[{"text":"Vahşi hayvanlar bir araya toplandığında,"}]},{"verse_key":"81:6","translations":[{"text":"Denizler ateşlendiğinde (suları çekilip, volkanlar halinde ateş püskürdüğünde),"}]},{"verse_key":"81:7","translations":[{"text":"Nefisler eşleştirildiğinde (iyiler iyilerle, kötüler kötülerle bir araya toplandığında),"}]},{"verse_key":"81:8","translations":[{"text":"Diri diri toprağa gömülen kıza sorulduğunda,"}]},{"verse_key":"81:9","translations":[{"text":"\"Hangi günahtan dolayı öldürüldü?\" diye."}]},{"verse_key":"81:10","translations":[{"text":"Amel defterleri açıldığında,"}]},{"verse_key":"81:11","translations":[{"text":"Gök sıyrılıp açıldığında,"}]},{"verse_key":"81:12","translations":[{"text":"Ebedi Ateş kızıştırıldığında,"}]},{"verse_key":"81:13","translations":[{"text":"Ve ebedi bahçeler yaklaştırıldığında,"}]},{"verse_key":"81:14","translations":[{"text":"Herkes ne getirmiş olduğunu anlar."}]},{"verse_key":"81:15","translations":[{"text":"Şimdi yemin ederim o sinenlere (gündüzleri gözden kaybolan yıldızlara),"}]},{"verse_key":"81:16","translations":[{"text":"O akıp akıp yuvasına gidenlere,"}]},{"verse_key":"81:17","translations":[{"text":"Yöneldiği an geceye,"}]},{"verse_key":"81:18","translations":[{"text":"Nefeslendiği (ağardığı) an sabaha ki,"}]},{"verse_key":"81:19","translations":[{"text":"Kuşkusuz o Kur'an, değerli bir elçinin sözüdür."}]},{"verse_key":"81:20","translations":[{"text":"O elçi güçlüdür, Arş'ın sahibinin yanında çok itibarlıdır."}]},{"verse_key":"81:21","translations":[{"text":"Orada ona itaat edilir, güvenilir."}]},{"verse_key":"81:22","translations":[{"text":"Arkadaşınızı cin çarpmış değildir."}]},{"verse_key":"81:23","translations":[{"text":"Andolsun o, Cebrail'i açık ufukta gördü."}]},{"verse_key":"81:24","translations":[{"text":"O, gayb hakkında cimri de değildir."}]},{"verse_key":"81:25","translations":[{"text":"O, kovulmuş bir şeytanın sözü değildir."}]},{"verse_key":"81:26","translations":[{"text":"Hâl böyle iken, siz nereye gidiyorsunuz?"}]},{"verse_key":"81:27","translations":[{"text":"O, âlemler için öğütten başka bir şey değildir,"}]},{"verse_key":"81:28","translations":[{"text":"İçinizden doğru gitmek isteyenler için."}]},{"verse_key":"81:29","translations":[{"text":"Âlemlerin Rabbi olan Allah dilemeyince, siz dileyemezsiniz."}]}]