[{"verse_key":"55:1","translations":[{"text":"Rahmân (çok merhametli olan Allah)"}]},{"verse_key":"55:2","translations":[{"text":"Kurân'ı öğretti."}]},{"verse_key":"55:3","translations":[{"text":"İnsanı yarattı."}]},{"verse_key":"55:4","translations":[{"text":"Ona beyanı öğretti."}]},{"verse_key":"55:5","translations":[{"text":"Güneş de ay da bir hesab iledir."}]},{"verse_key":"55:6","translations":[{"text":"Bitkiler ve ağaçlar secde etmektedirler."}]},{"verse_key":"55:7","translations":[{"text":"Göğü yükseltti ve mizanı koydu."}]},{"verse_key":"55:8","translations":[{"text":"Sakın tartıda taşkınlık etmeyin."}]},{"verse_key":"55:9","translations":[{"text":"Tartıyı adaletle yapın, terazide eksiklik yapmayın."}]},{"verse_key":"55:10","translations":[{"text":"(Allah) yeri mahlukat için (aşağıya) koydu."}]},{"verse_key":"55:11","translations":[{"text":"Orada meyvalar ve salkımlı hurma ağaçları vardır."}]},{"verse_key":"55:12","translations":[{"text":"Yapraklı taneler ve hoş kokulu bitkiler vardır."}]},{"verse_key":"55:13","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:14","translations":[{"text":"Allah insanı, pişmiş bir çamura benzeyen bir balçıktan yarattı."}]},{"verse_key":"55:15","translations":[{"text":"Cinleri de hâlis ateşten yarattı."}]},{"verse_key":"55:16","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:17","translations":[{"text":"(O) iki doğunun ve iki batının Rabbidir."}]},{"verse_key":"55:18","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:19","translations":[{"text":"(Acı ve tatlı) iki denizi salıverdi birbirine kavuşuyorlar."}]},{"verse_key":"55:20","translations":[{"text":"Fakat aralarında bir engel vardır, birbirlerine geçip karışmıyorlar."}]},{"verse_key":"55:21","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:22","translations":[{"text":"İkisinden de inci ve mercan çıkar."}]},{"verse_key":"55:23","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:24","translations":[{"text":"Denizde koca dağlar gibi yükselen gemiler de onundur."}]},{"verse_key":"55:25","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:26","translations":[{"text":"Yer üzerinde bulunan her şey fânidir."}]},{"verse_key":"55:27","translations":[{"text":"Yalnız celâl ve ikram sahibi Rabbinin yüzü (zâtı) baki kalacaktır."}]},{"verse_key":"55:28","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:29","translations":[{"text":"Göklerde ve yerde bulunanlar, O'ndan isterler. O, her gün yeni bir iştedir."}]},{"verse_key":"55:30","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:31","translations":[{"text":"Ey insan ve cin! sizin de hesabınızı ele alacağız."}]},{"verse_key":"55:32","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:33","translations":[{"text":"Ey cin ve insan toplulukları! Göklerin ve yerin çevresinden geçmeye gücünüz yeterse geçin gidin. Allah'ın verdiği bir güç olmadan geçemezsiniz."}]},{"verse_key":"55:34","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:35","translations":[{"text":"Üzerinize ateşten alev ve duman gönderilir, kendinizi savunamazsınız."}]},{"verse_key":"55:36","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz"}]},{"verse_key":"55:37","translations":[{"text":"Gök yarılıp da, erimiş yağ gibi kıpkırmızı bir gül olduğu zaman..."}]},{"verse_key":"55:38","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:39","translations":[{"text":"İşte o gün, ne insana ne de cinne günahından sorulmaz."}]},{"verse_key":"55:40","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:41","translations":[{"text":"Suçlular simalarından tanınır, alınlarından ve ayaklarından tutulur."}]},{"verse_key":"55:42","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:43","translations":[{"text":"İşte bu, suçluların yalanladığı cehennemdir."}]},{"verse_key":"55:44","translations":[{"text":"Onunla kaynar su arasında dolaşırlar."}]},{"verse_key":"55:45","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:46","translations":[{"text":"Rabbinin makamından korkan kimselere iki ebedi bahçeler vardır."}]},{"verse_key":"55:47","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:48","translations":[{"text":"İkisinin de çeşitli ağaçları, meyvaları vardır."}]},{"verse_key":"55:49","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:50","translations":[{"text":"İkisinde de akıp giden iki kaynak vardır."}]},{"verse_key":"55:51","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:52","translations":[{"text":"İkisinde de her türlü meyvadan çift çift vardır."}]},{"verse_key":"55:53","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:54","translations":[{"text":"Astarları atlastan yataklara yaslanırlar. İki cennetin de devşirmesi yakındır."}]},{"verse_key":"55:55","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:56","translations":[{"text":"Oralarda gözlerini yalnız eşlerine çevirmiş dilberler var ki, bunlardan önce onlara ne insan ne de cin dokunmuştur."}]},{"verse_key":"55:57","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:58","translations":[{"text":"Sanki onlar yâkut ve mercandırlar."}]},{"verse_key":"55:59","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:60","translations":[{"text":"İyiliğin karşılığı, yalnız iyilik değil midir?"}]},{"verse_key":"55:61","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:62","translations":[{"text":"Bu ikisinden başka iki ebedi bahçeler daha vardır."}]},{"verse_key":"55:63","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:64","translations":[{"text":"(Bu cennetler) yemyeşildirler."}]},{"verse_key":"55:65","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:66","translations":[{"text":"İkisinde de fışkıran iki kaynak vardır."}]},{"verse_key":"55:67","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:68","translations":[{"text":"İkisinde de her türlü meyva, hurma ve nar vardır."}]},{"verse_key":"55:69","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:70","translations":[{"text":"İçlerinde güzel huylu, güzel yüzlü kadınlar vardır."}]},{"verse_key":"55:71","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:72","translations":[{"text":"Çadırlar içerisinde gözlerini yalnız kocalarına çevirmiş hûriler vardır."}]},{"verse_key":"55:73","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:74","translations":[{"text":"Bunlardan önce onlara ne insan ne de cin dokunmuştur."}]},{"verse_key":"55:75","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:76","translations":[{"text":"Yeşil yastıklara ve hârikulâde güzel işlemeli döşeklere yaslanırlar."}]},{"verse_key":"55:77","translations":[{"text":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"}]},{"verse_key":"55:78","translations":[{"text":"Büyüklük ve ikram sahibi Rabbinin adı ne yücedir!"}]}]