[{"verse_key":"105:1","translations":[{"text":"Görmedin mi Rabb'in fil sahiplerine ne yaptı?"}]},{"verse_key":"105:2","translations":[{"text":"Onların tuzaklarını boşa çıkarmadı mı?"}]},{"verse_key":"105:3","translations":[{"text":"Üzerlerine sürü sürü kuşlar gönderdi."}]},{"verse_key":"105:4","translations":[{"text":"Onlara çamurdan sertleşmiş taşlar atıyorlardı."}]},{"verse_key":"105:5","translations":[{"text":"Ve onları, yenilmiş ekin yaprağı gibi yaptı."}]}]