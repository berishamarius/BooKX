[{"verse_key":"93:1","translations":[{"text":"Andolsun kuşluk vaktine."}]},{"verse_key":"93:2","translations":[{"text":"Ve sakinleştiği zaman geceye ki,"}]},{"verse_key":"93:3","translations":[{"text":"Rabbin seni bırakmadı ve darılmadı."}]},{"verse_key":"93:4","translations":[{"text":"Ahiret senin için dünyadan iyi olacaktır."}]},{"verse_key":"93:5","translations":[{"text":"Rabbın sana verecek ve sen hoşnut olacaksın."}]},{"verse_key":"93:6","translations":[{"text":"O seni yetim bulup da barındırmadı mı?"}]},{"verse_key":"93:7","translations":[{"text":"Seni yol bilmez bulup yola iletmedi mi?"}]},{"verse_key":"93:8","translations":[{"text":"Seni yoksul bulup zengin etmedi mi?"}]},{"verse_key":"93:9","translations":[{"text":"Öyleyse sakın yetimi ezme."}]},{"verse_key":"93:10","translations":[{"text":"Dilenciyi de azarlama."}]},{"verse_key":"93:11","translations":[{"text":"Fakat Rabbinin nimetini anlat da anlat."}]}]