[{"verse_key":"100:1","translations":[{"text":"O harıl harıl (savaşa) koşanlara,"}]},{"verse_key":"100:2","translations":[{"text":"(Tırnaklarıyla yerden) ateş çıkaranlara,"}]},{"verse_key":"100:3","translations":[{"text":"Sabahleyin akın edenlere,"}]},{"verse_key":"100:4","translations":[{"text":"Tozu dumana karıştıranlara,"}]},{"verse_key":"100:5","translations":[{"text":"Derken bir topluluğun ortasına dalanlara yemin ederim ki,"}]},{"verse_key":"100:6","translations":[{"text":"Şüphesiz insan, Rabbine karşı çok nankördür."}]},{"verse_key":"100:7","translations":[{"text":"Ve kendisi de buna şahittir."}]},{"verse_key":"100:8","translations":[{"text":"Gerçekten o dünya malını çok sevdiği için katıdır."}]},{"verse_key":"100:9","translations":[{"text":"Bilmiyor mu ki, kabirlerin içindekiler fırlatılacak."}]},{"verse_key":"100:10","translations":[{"text":"Ve sinelerin içindekiler derlenecek."}]},{"verse_key":"100:11","translations":[{"text":"O gün Rableri onların bütün yaptıklarından haberdardır"}]}]