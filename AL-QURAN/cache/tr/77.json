[{"verse_key":"77:1","translations":[{"text":"Andolsun birbiri ardınca gönderilenlere,"}]},{"verse_key":"77:2","translations":[{"text":"Büküp devirenlere,"}]},{"verse_key":"77:3","translations":[{"text":"Yaydıkça yayanlara,"}]},{"verse_key":"77:4","translations":[{"text":"Seçip ayıranlara,"}]},{"verse_key":"77:5","translations":[{"text":"Bir öğüt bırakanlara,"}]},{"verse_key":"77:6","translations":[{"text":"Gerek özür için olsun, gerek uyarı için,"}]},{"verse_key":"77:7","translations":[{"text":"Herhalde size vaad olunan kesinlikle olacaktır."}]},{"verse_key":"77:8","translations":[{"text":"Hani o yıldızlar silindiği zaman,"}]},{"verse_key":"77:9","translations":[{"text":"Gök yarıldığı zaman,"}]},{"verse_key":"77:10","translations":[{"text":"Dağlar savrulduğu zaman,"}]},{"verse_key":"77:11","translations":[{"text":"Elçiler, tayin edilen vakitlerine erdirildikleri zaman,"}]},{"verse_key":"77:12","translations":[{"text":"Bunlar hangi güne ertelendiler?"}]},{"verse_key":"77:13","translations":[{"text":"Hüküm gününe.."}]},{"verse_key":"77:14","translations":[{"text":"Bildin mi, nedir o hüküm günü?"}]},{"verse_key":"77:15","translations":[{"text":"O gün yalanlayanların vay haline!"}]},{"verse_key":"77:16","translations":[{"text":"Biz, öncekileri helak etmedik mi?"}]},{"verse_key":"77:17","translations":[{"text":"Sonra geridekileri de onlara katarız."}]},{"verse_key":"77:18","translations":[{"text":"Biz suçlulara böyle yaparız."}]},{"verse_key":"77:19","translations":[{"text":"O gün yalanlayanların vah haline!"}]},{"verse_key":"77:20","translations":[{"text":"Biz sizi âdi bir sudan yaratmadık mı?"}]},{"verse_key":"77:21","translations":[{"text":"Onu sağlam bir yerde oturttuk."}]},{"verse_key":"77:22","translations":[{"text":"Belli bir süreye kadar."}]},{"verse_key":"77:23","translations":[{"text":"Demek ki biçimlendirmişiz. Ne güzel biçimlendireniz biz."}]},{"verse_key":"77:24","translations":[{"text":"O gün yalanlayanların vay haline!"}]},{"verse_key":"77:25","translations":[{"text":"Yeryüzünü bir tokat (toplanma yeri) yapmadık mı?"}]},{"verse_key":"77:26","translations":[{"text":"Gerek diriler, gerekse ölüler için."}]},{"verse_key":"77:27","translations":[{"text":"Orada yüksek yüksek dağlar oturtup da size bir tatlı su sunmadık mı?"}]},{"verse_key":"77:28","translations":[{"text":"O gün yalanlayanların vay haline!"}]},{"verse_key":"77:29","translations":[{"text":"(Kıyameti yalanlayanlara şöyle denir): \"Haydin gidin o yalanladığınız şeye doğru.\""}]},{"verse_key":"77:30","translations":[{"text":"\"Haydi gidin o üç çatallı gölgeye (cehenneme).\""}]},{"verse_key":"77:31","translations":[{"text":"O, ne gölgelendirir, ne alevden korur."}]},{"verse_key":"77:32","translations":[{"text":"O, saray gibi kıvılcımlar atar."}]},{"verse_key":"77:33","translations":[{"text":"Sanki o kıvılcımlar, sarı sarı (erkek deve sürüleridir)."}]},{"verse_key":"77:34","translations":[{"text":"O gün yalanlayanların vay haline!"}]},{"verse_key":"77:35","translations":[{"text":"Bugün, konuşamıyacakları gündür."}]},{"verse_key":"77:36","translations":[{"text":"Kendilerine izin de verilmez ki, özür beyan etsinler."}]},{"verse_key":"77:37","translations":[{"text":"O gün yalanlayanların vay haline!"}]},{"verse_key":"77:38","translations":[{"text":"Bu, işte o hüküm günüdür. Sizi ve öncekileri bir araya topladık."}]},{"verse_key":"77:39","translations":[{"text":"Bir hileniz varsa beni atlatın."}]},{"verse_key":"77:40","translations":[{"text":"O gün yalanlayanların vay haline!"}]},{"verse_key":"77:41","translations":[{"text":"Kuşkusuz takva sahipleri gölgeler altında ve pınar başlarındadır."}]},{"verse_key":"77:42","translations":[{"text":"Canlarının çektiğinden türlü meyveler arasındadırlar."}]},{"verse_key":"77:43","translations":[{"text":"(Onlara): \"Yaptıklarınıza karşılık afiyetle yiyin, için\" (denir)."}]},{"verse_key":"77:44","translations":[{"text":"İşte biz güzel amel işleyenleri böyle mükafatlandırırız."}]},{"verse_key":"77:45","translations":[{"text":"O gün yalanlayanların vay haline!"}]},{"verse_key":"77:46","translations":[{"text":"Yiyin, zevklenin biraz, çünkü siz suçlularsınız."}]},{"verse_key":"77:47","translations":[{"text":"O gün yalanlayanların vay haline!"}]},{"verse_key":"77:48","translations":[{"text":"Onlara: \"Rüku edin\" denildiği zaman etmezler."}]},{"verse_key":"77:49","translations":[{"text":"Vay haline o gün yalanlayanların!"}]},{"verse_key":"77:50","translations":[{"text":"Artık bundan (Kur'an'dan) sonra hangi söze inanacaklar?"}]}]