[{"verse_key":"88:1","translations":[{"text":"O her şeyi kuşatacak olan Kıyamet'in haberi sana geldi mi?"}]},{"verse_key":"88:2","translations":[{"text":"Yüzler var ki, o gün eğilmiş, zillete düşmüştür."}]},{"verse_key":"88:3","translations":[{"text":"Çalışmış, yorulmuştur."}]},{"verse_key":"88:4","translations":[{"text":"Kızışmış bir ateşe girer."}]},{"verse_key":"88:5","translations":[{"text":"Onlara kızgın bir kaynaktan su verilir."}]},{"verse_key":"88:6","translations":[{"text":"Onlar için kuru bir dikenden başka yiyecek de yoktur."}]},{"verse_key":"88:7","translations":[{"text":"O da ne besler, ne de açlığı giderir."}]},{"verse_key":"88:8","translations":[{"text":"Yüzler de var ki, o gün nimetle mutludur."}]},{"verse_key":"88:9","translations":[{"text":"Yaptığından hoşnuttur."}]},{"verse_key":"88:10","translations":[{"text":"Yüksek bir cennettedir."}]},{"verse_key":"88:11","translations":[{"text":"Orada boş bir söz işitmez."}]},{"verse_key":"88:12","translations":[{"text":"Orada akan bir kaynak,"}]},{"verse_key":"88:13","translations":[{"text":"Yükseltilmiş divanlar,"}]},{"verse_key":"88:14","translations":[{"text":"Konulmuş kadehler,"}]},{"verse_key":"88:15","translations":[{"text":"Dizilmiş koltuklar, yastıklar,"}]},{"verse_key":"88:16","translations":[{"text":"Serilmiş halılar vardır."}]},{"verse_key":"88:17","translations":[{"text":"Bakmıyorlar mı o develere, nasıl yaratılmış?"}]},{"verse_key":"88:18","translations":[{"text":"Göğe bakmıyorlar mı, nasıl yükseltilmiş?"}]},{"verse_key":"88:19","translations":[{"text":"Bakmıyorlar mı dağlara, nasıl dikilmiş?"}]},{"verse_key":"88:20","translations":[{"text":"Yere bakmıyorlar mı, nasıl yayılmış?"}]},{"verse_key":"88:21","translations":[{"text":"Haydi öğüt ver; sen şimdi sırf bir öğütçüsün."}]},{"verse_key":"88:22","translations":[{"text":"Onların üzerinde bir zorba değilsin."}]},{"verse_key":"88:23","translations":[{"text":"Ancak kim yüz çevirir ve kâfir olursa,"}]},{"verse_key":"88:24","translations":[{"text":"Allah ona en büyük azap ile azap edecek."}]},{"verse_key":"88:25","translations":[{"text":"Kuşkusuz onlar döne dolaşa bize gelecekler."}]},{"verse_key":"88:26","translations":[{"text":"Sonra da bize hesap verecekler."}]}]