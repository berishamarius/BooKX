[{"verse_key":"80:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ عَبَسَ وَتَوَلَّىٰ"}]},{"verse_key":"80:2","translations":[{"text":"أَنْ جَاءَهُ الْأَعْمَىٰ"}]},{"verse_key":"80:3","translations":[{"text":"وَمَا يُدْرِيكَ لَعَلَّهُ يَزَّكَّىٰ"}]},{"verse_key":"80:4","translations":[{"text":"أَوْ يَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرَىٰ"}]},{"verse_key":"80:5","translations":[{"text":"أَمَّا مَنِ اسْتَغْنَىٰ"}]},{"verse_key":"80:6","translations":[{"text":"فَأَنْتَ لَهُ تَصَدَّىٰ"}]},{"verse_key":"80:7","translations":[{"text":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ"}]},{"verse_key":"80:8","translations":[{"text":"وَأَمَّا مَنْ جَاءَكَ يَسْعَىٰ"}]},{"verse_key":"80:9","translations":[{"text":"وَهُوَ يَخْشَىٰ"}]},{"verse_key":"80:10","translations":[{"text":"فَأَنْتَ عَنْهُ تَلَهَّىٰ"}]},{"verse_key":"80:11","translations":[{"text":"كَلَّا إِنَّهَا تَذْكِرَةٌ"}]},{"verse_key":"80:12","translations":[{"text":"فَمَنْ شَاءَ ذَكَرَهُ"}]},{"verse_key":"80:13","translations":[{"text":"فِي صُحُفٍ مُكَرَّمَةٍ"}]},{"verse_key":"80:14","translations":[{"text":"مَرْفُوعَةٍ مُطَهَّرَةٍ"}]},{"verse_key":"80:15","translations":[{"text":"بِأَيْدِي سَفَرَةٍ"}]},{"verse_key":"80:16","translations":[{"text":"كِرَامٍ بَرَرَةٍ"}]},{"verse_key":"80:17","translations":[{"text":"قُتِلَ الْإِنْسَانُ مَا أَكْفَرَهُ"}]},{"verse_key":"80:18","translations":[{"text":"مِنْ أَيِّ شَيْءٍ خَلَقَهُ"}]},{"verse_key":"80:19","translations":[{"text":"مِنْ نُطْفَةٍ خَلَقَهُ فَقَدَّرَهُ"}]},{"verse_key":"80:20","translations":[{"text":"ثُمَّ السَّبِيلَ يَسَّرَهُ"}]},{"verse_key":"80:21","translations":[{"text":"ثُمَّ أَمَاتَهُ فَأَقْبَرَهُ"}]},{"verse_key":"80:22","translations":[{"text":"ثُمَّ إِذَا شَاءَ أَنْشَرَهُ"}]},{"verse_key":"80:23","translations":[{"text":"كَلَّا لَمَّا يَقْضِ مَا أَمَرَهُ"}]},{"verse_key":"80:24","translations":[{"text":"فَلْيَنْظُرِ الْإِنْسَانُ إِلَىٰ طَعَامِهِ"}]},{"verse_key":"80:25","translations":[{"text":"أَنَّا صَبَبْنَا الْمَاءَ صَبًّا"}]},{"verse_key":"80:26","translations":[{"text":"ثُمَّ شَقَقْنَا الْأَرْضَ شَقًّا"}]},{"verse_key":"80:27","translations":[{"text":"فَأَنْبَتْنَا فِيهَا حَبًّا"}]},{"verse_key":"80:28","translations":[{"text":"وَعِنَبًا وَقَضْبًا"}]},{"verse_key":"80:29","translations":[{"text":"وَزَيْتُونًا وَنَخْلًا"}]},{"verse_key":"80:30","translations":[{"text":"وَحَدَائِقَ غُلْبًا"}]},{"verse_key":"80:31","translations":[{"text":"وَفَاكِهَةً وَأَبًّا"}]},{"verse_key":"80:32","translations":[{"text":"مَتَاعًا لَكُمْ وَلِأَنْعَامِكُمْ"}]},{"verse_key":"80:33","translations":[{"text":"فَإِذَا جَاءَتِ الصَّاخَّةُ"}]},{"verse_key":"80:34","translations":[{"text":"يَوْمَ يَفِرُّ الْمَرْءُ مِنْ أَخِيهِ"}]},{"verse_key":"80:35","translations":[{"text":"وَأُمِّهِ وَأَبِيهِ"}]},{"verse_key":"80:36","translations":[{"text":"وَصَاحِبَتِهِ وَبَنِيهِ"}]},{"verse_key":"80:37","translations":[{"text":"لِكُلِّ امْرِئٍ مِنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ"}]},{"verse_key":"80:38","translations":[{"text":"وُجُوهٌ يَوْمَئِذٍ مُسْفِرَةٌ"}]},{"verse_key":"80:39","translations":[{"text":"ضَاحِكَةٌ مُسْتَبْشِرَةٌ"}]},{"verse_key":"80:40","translations":[{"text":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ"}]},{"verse_key":"80:41","translations":[{"text":"تَرْهَقُهَا قَتَرَةٌ"}]},{"verse_key":"80:42","translations":[{"text":"أُولَٰئِكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ"}]}]