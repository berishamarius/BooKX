[{"verse_key":"90:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ لَا أُقْسِمُ بِهَٰذَا الْبَلَدِ"}]},{"verse_key":"90:2","translations":[{"text":"وَأَنْتَ حِلٌّ بِهَٰذَا الْبَلَدِ"}]},{"verse_key":"90:3","translations":[{"text":"وَوَالِدٍ وَمَا وَلَدَ"}]},{"verse_key":"90:4","translations":[{"text":"لَقَدْ خَلَقْنَا الْإِنْسَانَ فِي كَبَدٍ"}]},{"verse_key":"90:5","translations":[{"text":"أَيَحْسَبُ أَنْ لَنْ يَقْدِرَ عَلَيْهِ أَحَدٌ"}]},{"verse_key":"90:6","translations":[{"text":"يَقُولُ أَهْلَكْتُ مَالًا لُبَدًا"}]},{"verse_key":"90:7","translations":[{"text":"أَيَحْسَبُ أَنْ لَمْ يَرَهُ أَحَدٌ"}]},{"verse_key":"90:8","translations":[{"text":"أَلَمْ نَجْعَلْ لَهُ عَيْنَيْنِ"}]},{"verse_key":"90:9","translations":[{"text":"وَلِسَانًا وَشَفَتَيْنِ"}]},{"verse_key":"90:10","translations":[{"text":"وَهَدَيْنَاهُ النَّجْدَيْنِ"}]},{"verse_key":"90:11","translations":[{"text":"فَلَا اقْتَحَمَ الْعَقَبَةَ"}]},{"verse_key":"90:12","translations":[{"text":"وَمَا أَدْرَاكَ مَا الْعَقَبَةُ"}]},{"verse_key":"90:13","translations":[{"text":"فَكُّ رَقَبَةٍ"}]},{"verse_key":"90:14","translations":[{"text":"أَوْ إِطْعَامٌ فِي يَوْمٍ ذِي مَسْغَبَةٍ"}]},{"verse_key":"90:15","translations":[{"text":"يَتِيمًا ذَا مَقْرَبَةٍ"}]},{"verse_key":"90:16","translations":[{"text":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ"}]},{"verse_key":"90:17","translations":[{"text":"ثُمَّ كَانَ مِنَ الَّذِينَ آمَنُوا وَتَوَاصَوْا بِالصَّبْرِ وَتَوَاصَوْا بِالْمَرْحَمَةِ"}]},{"verse_key":"90:18","translations":[{"text":"أُولَٰئِكَ أَصْحَابُ الْمَيْمَنَةِ"}]},{"verse_key":"90:19","translations":[{"text":"وَالَّذِينَ كَفَرُوا بِآيَاتِنَا هُمْ أَصْحَابُ الْمَشْأَمَةِ"}]},{"verse_key":"90:20","translations":[{"text":"عَلَيْهِمْ نَارٌ مُؤْصَدَةٌ"}]}]