[{"verse_key":"105:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَابِ الْفِيلِ"}]},{"verse_key":"105:2","translations":[{"text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِي تَضْلِيلٍ"}]},{"verse_key":"105:3","translations":[{"text":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ"}]},{"verse_key":"105:4","translations":[{"text":"تَرْمِيهِمْ بِحِجَارَةٍ مِنْ سِجِّيلٍ"}]},{"verse_key":"105:5","translations":[{"text":"فَجَعَلَهُمْ كَعَصْفٍ مَأْكُولٍ"}]}]