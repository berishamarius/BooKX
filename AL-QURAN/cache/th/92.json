[{"verse_key":"92:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَاللَّيْلِ إِذَا يَغْشَىٰ"}]},{"verse_key":"92:2","translations":[{"text":"وَالنَّهَارِ إِذَا تَجَلَّىٰ"}]},{"verse_key":"92:3","translations":[{"text":"وَمَا خَلَقَ الذَّكَرَ وَالْأُنْثَىٰ"}]},{"verse_key":"92:4","translations":[{"text":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ"}]},{"verse_key":"92:5","translations":[{"text":"فَأَمَّا مَنْ أَعْطَىٰ وَاتَّقَىٰ"}]},{"verse_key":"92:6","translations":[{"text":"وَصَدَّقَ بِالْحُسْنَىٰ"}]},{"verse_key":"92:7","translations":[{"text":"فَسَنُيَسِّرُهُ لِلْيُسْرَىٰ"}]},{"verse_key":"92:8","translations":[{"text":"وَأَمَّا مَنْ بَخِلَ وَاسْتَغْنَىٰ"}]},{"verse_key":"92:9","translations":[{"text":"وَكَذَّبَ بِالْحُسْنَىٰ"}]},{"verse_key":"92:10","translations":[{"text":"فَسَنُيَسِّرُهُ لِلْعُسْرَىٰ"}]},{"verse_key":"92:11","translations":[{"text":"وَمَا يُغْنِي عَنْهُ مَالُهُ إِذَا تَرَدَّىٰ"}]},{"verse_key":"92:12","translations":[{"text":"إِنَّ عَلَيْنَا لَلْهُدَىٰ"}]},{"verse_key":"92:13","translations":[{"text":"وَإِنَّ لَنَا لَلْآخِرَةَ وَالْأُولَىٰ"}]},{"verse_key":"92:14","translations":[{"text":"فَأَنْذَرْتُكُمْ نَارًا تَلَظَّىٰ"}]},{"verse_key":"92:15","translations":[{"text":"لَا يَصْلَاهَا إِلَّا الْأَشْقَى"}]},{"verse_key":"92:16","translations":[{"text":"الَّذِي كَذَّبَ وَتَوَلَّىٰ"}]},{"verse_key":"92:17","translations":[{"text":"وَسَيُجَنَّبُهَا الْأَتْقَى"}]},{"verse_key":"92:18","translations":[{"text":"الَّذِي يُؤْتِي مَالَهُ يَتَزَكَّىٰ"}]},{"verse_key":"92:19","translations":[{"text":"وَمَا لِأَحَدٍ عِنْدَهُ مِنْ نِعْمَةٍ تُجْزَىٰ"}]},{"verse_key":"92:20","translations":[{"text":"إِلَّا ابْتِغَاءَ وَجْهِ رَبِّهِ الْأَعْلَىٰ"}]},{"verse_key":"92:21","translations":[{"text":"وَلَسَوْفَ يَرْضَىٰ"}]}]