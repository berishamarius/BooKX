[{"verse_key":"102:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ أَلْهَاكُمُ التَّكَاثُرُ"}]},{"verse_key":"102:2","translations":[{"text":"حَتَّىٰ زُرْتُمُ الْمَقَابِرَ"}]},{"verse_key":"102:3","translations":[{"text":"كَلَّا سَوْفَ تَعْلَمُونَ"}]},{"verse_key":"102:4","translations":[{"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ"}]},{"verse_key":"102:5","translations":[{"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ الْيَقِينِ"}]},{"verse_key":"102:6","translations":[{"text":"لَتَرَوُنَّ الْجَحِيمَ"}]},{"verse_key":"102:7","translations":[{"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ الْيَقِينِ"}]},{"verse_key":"102:8","translations":[{"text":"ثُمَّ لَتُسْأَلُنَّ يَوْمَئِذٍ عَنِ النَّعِيمِ"}]}]