[{"verse_key":"112:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ قُلْ هُوَ اللَّهُ أَحَدٌ"}]},{"verse_key":"112:2","translations":[{"text":"اللَّهُ الصَّمَدُ"}]},{"verse_key":"112:3","translations":[{"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ"}]},{"verse_key":"112:4","translations":[{"text":"وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ"}]}]