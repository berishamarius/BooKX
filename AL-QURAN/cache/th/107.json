[{"verse_key":"107:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ أَرَأَيْتَ الَّذِي يُكَذِّبُ بِالدِّينِ"}]},{"verse_key":"107:2","translations":[{"text":"فَذَٰلِكَ الَّذِي يَدُعُّ الْيَتِيمَ"}]},{"verse_key":"107:3","translations":[{"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ الْمِسْكِينِ"}]},{"verse_key":"107:4","translations":[{"text":"فَوَيْلٌ لِلْمُصَلِّينَ"}]},{"verse_key":"107:5","translations":[{"text":"الَّذِينَ هُمْ عَنْ صَلَاتِهِمْ سَاهُونَ"}]},{"verse_key":"107:6","translations":[{"text":"الَّذِينَ هُمْ يُرَاءُونَ"}]},{"verse_key":"107:7","translations":[{"text":"وَيَمْنَعُونَ الْمَاعُونَ"}]}]