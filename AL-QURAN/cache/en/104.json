[{"verse_key":"104:1","translations":[{"text":"Woe to every slanderer backbiter."}]},{"verse_key":"104:2","translations":[{"text":"Who gathers wealth and counts it over."}]},{"verse_key":"104:3","translations":[{"text":"Thinking that his wealth has made him immortal."}]},{"verse_key":"104:4","translations":[{"text":"By no means. He will be thrown into the Crusher."}]},{"verse_key":"104:5","translations":[{"text":"And what will make you realize what the Crusher is?"}]},{"verse_key":"104:6","translations":[{"text":"God's kindled Fire."}]},{"verse_key":"104:7","translations":[{"text":"That laps to the hearts."}]},{"verse_key":"104:8","translations":[{"text":"It closes in on them."}]},{"verse_key":"104:9","translations":[{"text":"In extended columns."}]}]