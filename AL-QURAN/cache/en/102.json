[{"verse_key":"102:1","translations":[{"text":"Abundance distracts you."}]},{"verse_key":"102:2","translations":[{"text":"Until you visit the graveyards."}]},{"verse_key":"102:3","translations":[{"text":"Indeed, you will know."}]},{"verse_key":"102:4","translations":[{"text":"Certainly, you will know."}]},{"verse_key":"102:5","translations":[{"text":"If you knew with knowledge of certainty."}]},{"verse_key":"102:6","translations":[{"text":"You would see the Inferno."}]},{"verse_key":"102:7","translations":[{"text":"Then you will see it with the eye of certainty."}]},{"verse_key":"102:8","translations":[{"text":"Then, on that Day, you will be questioned about the Bliss."}]}]