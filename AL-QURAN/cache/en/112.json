[{"verse_key":"112:1","translations":[{"text":"Say, “He is God, the One."}]},{"verse_key":"112:2","translations":[{"text":"God, the Absolute."}]},{"verse_key":"112:3","translations":[{"text":"He begets not, nor was He begotten."}]},{"verse_key":"112:4","translations":[{"text":"And there is nothing comparable to Him.”"}]}]