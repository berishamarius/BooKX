[{"verse_key":"107:1","translations":[{"text":"Tahukah kamu (orang) yang mendustakan agama?"}]},{"verse_key":"107:2","translations":[{"text":"Itulah orang yang menghardik anak yatim,"}]},{"verse_key":"107:3","translations":[{"text":"dan tidak menganjurkan memberi makan orang miskin."}]},{"verse_key":"107:4","translations":[{"text":"Maka kecelakaanlah bagi orang-orang yang mendirikan shalat (ibadah),"}]},{"verse_key":"107:5","translations":[{"text":"(yaitu) orang-orang yang lalai dari shalatnya,"}]},{"verse_key":"107:6","translations":[{"text":"orang-orang yang berbuat riya,"}]},{"verse_key":"107:7","translations":[{"text":"dan enggan (menolong dengan) barang berguna."}]}]