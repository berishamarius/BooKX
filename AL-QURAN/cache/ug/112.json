[{"verse_key":"112:1","translations":[{"text":"(ئى مۇھەممەد!) ئېيتقىنكى، ئۇ - اﷲ بىردۇر"}]},{"verse_key":"112:2","translations":[{"text":"ھەممە اﷲ قا موھتاجدۇر"}]},{"verse_key":"112:3","translations":[{"text":"اﷲ بالا تاپقانمۇ ئەمەس، تۇغۇلغانمۇ ئەمەس"}]},{"verse_key":"112:4","translations":[{"text":"ھېچ كىشى ئۇنىڭغا تەڭداش بولالمايدۇ"}]}]