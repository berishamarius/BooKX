[{"verse_key":"86:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالسَّمَاءِ وَالطَّارِقِ"}]},{"verse_key":"86:2","translations":[{"text":"وَمَا أَدْرَاكَ مَا الطَّارِقُ"}]},{"verse_key":"86:3","translations":[{"text":"النَّجْمُ الثَّاقِبُ"}]},{"verse_key":"86:4","translations":[{"text":"إِنْ كُلُّ نَفْسٍ لَمَّا عَلَيْهَا حَافِظٌ"}]},{"verse_key":"86:5","translations":[{"text":"فَلْيَنْظُرِ الْإِنْسَانُ مِمَّ خُلِقَ"}]},{"verse_key":"86:6","translations":[{"text":"خُلِقَ مِنْ مَاءٍ دَافِقٍ"}]},{"verse_key":"86:7","translations":[{"text":"يَخْرُجُ مِنْ بَيْنِ الصُّلْبِ وَالتَّرَائِبِ"}]},{"verse_key":"86:8","translations":[{"text":"إِنَّهُ عَلَىٰ رَجْعِهِ لَقَادِرٌ"}]},{"verse_key":"86:9","translations":[{"text":"يَوْمَ تُبْلَى السَّرَائِرُ"}]},{"verse_key":"86:10","translations":[{"text":"فَمَا لَهُ مِنْ قُوَّةٍ وَلَا نَاصِرٍ"}]},{"verse_key":"86:11","translations":[{"text":"وَالسَّمَاءِ ذَاتِ الرَّجْعِ"}]},{"verse_key":"86:12","translations":[{"text":"وَالْأَرْضِ ذَاتِ الصَّدْعِ"}]},{"verse_key":"86:13","translations":[{"text":"إِنَّهُ لَقَوْلٌ فَصْلٌ"}]},{"verse_key":"86:14","translations":[{"text":"وَمَا هُوَ بِالْهَزْلِ"}]},{"verse_key":"86:15","translations":[{"text":"إِنَّهُمْ يَكِيدُونَ كَيْدًا"}]},{"verse_key":"86:16","translations":[{"text":"وَأَكِيدُ كَيْدًا"}]},{"verse_key":"86:17","translations":[{"text":"فَمَهِّلِ الْكَافِرِينَ أَمْهِلْهُمْ رُوَيْدًا"}]}]