[{"verse_key":"1:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"}]},{"verse_key":"1:2","translations":[{"text":"الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"}]},{"verse_key":"1:3","translations":[{"text":"الرَّحْمَٰنِ الرَّحِيمِ"}]},{"verse_key":"1:4","translations":[{"text":"مَالِكِ يَوْمِ الدِّينِ"}]},{"verse_key":"1:5","translations":[{"text":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"}]},{"verse_key":"1:6","translations":[{"text":"اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ"}]},{"verse_key":"1:7","translations":[{"text":"صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ"}]}]