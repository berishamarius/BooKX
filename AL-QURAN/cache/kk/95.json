[{"verse_key":"95:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالتِّينِ وَالزَّيْتُونِ"}]},{"verse_key":"95:2","translations":[{"text":"وَطُورِ سِينِينَ"}]},{"verse_key":"95:3","translations":[{"text":"وَهَٰذَا الْبَلَدِ الْأَمِينِ"}]},{"verse_key":"95:4","translations":[{"text":"لَقَدْ خَلَقْنَا الْإِنْسَانَ فِي أَحْسَنِ تَقْوِيمٍ"}]},{"verse_key":"95:5","translations":[{"text":"ثُمَّ رَدَدْنَاهُ أَسْفَلَ سَافِلِينَ"}]},{"verse_key":"95:6","translations":[{"text":"إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ"}]},{"verse_key":"95:7","translations":[{"text":"فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّينِ"}]},{"verse_key":"95:8","translations":[{"text":"أَلَيْسَ اللَّهُ بِأَحْكَمِ الْحَاكِمِينَ"}]}]