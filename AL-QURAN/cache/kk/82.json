[{"verse_key":"82:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِذَا السَّمَاءُ انْفَطَرَتْ"}]},{"verse_key":"82:2","translations":[{"text":"وَإِذَا الْكَوَاكِبُ انْتَثَرَتْ"}]},{"verse_key":"82:3","translations":[{"text":"وَإِذَا الْبِحَارُ فُجِّرَتْ"}]},{"verse_key":"82:4","translations":[{"text":"وَإِذَا الْقُبُورُ بُعْثِرَتْ"}]},{"verse_key":"82:5","translations":[{"text":"عَلِمَتْ نَفْسٌ مَا قَدَّمَتْ وَأَخَّرَتْ"}]},{"verse_key":"82:6","translations":[{"text":"يَا أَيُّهَا الْإِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ"}]},{"verse_key":"82:7","translations":[{"text":"الَّذِي خَلَقَكَ فَسَوَّاكَ فَعَدَلَكَ"}]},{"verse_key":"82:8","translations":[{"text":"فِي أَيِّ صُورَةٍ مَا شَاءَ رَكَّبَكَ"}]},{"verse_key":"82:9","translations":[{"text":"كَلَّا بَلْ تُكَذِّبُونَ بِالدِّينِ"}]},{"verse_key":"82:10","translations":[{"text":"وَإِنَّ عَلَيْكُمْ لَحَافِظِينَ"}]},{"verse_key":"82:11","translations":[{"text":"كِرَامًا كَاتِبِينَ"}]},{"verse_key":"82:12","translations":[{"text":"يَعْلَمُونَ مَا تَفْعَلُونَ"}]},{"verse_key":"82:13","translations":[{"text":"إِنَّ الْأَبْرَارَ لَفِي نَعِيمٍ"}]},{"verse_key":"82:14","translations":[{"text":"وَإِنَّ الْفُجَّارَ لَفِي جَحِيمٍ"}]},{"verse_key":"82:15","translations":[{"text":"يَصْلَوْنَهَا يَوْمَ الدِّينِ"}]},{"verse_key":"82:16","translations":[{"text":"وَمَا هُمْ عَنْهَا بِغَائِبِينَ"}]},{"verse_key":"82:17","translations":[{"text":"وَمَا أَدْرَاكَ مَا يَوْمُ الدِّينِ"}]},{"verse_key":"82:18","translations":[{"text":"ثُمَّ مَا أَدْرَاكَ مَا يَوْمُ الدِّينِ"}]},{"verse_key":"82:19","translations":[{"text":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِنَفْسٍ شَيْئًا ۖ وَالْأَمْرُ يَوْمَئِذٍ لِلَّهِ"}]}]