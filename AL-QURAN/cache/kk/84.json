[{"verse_key":"84:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِذَا السَّمَاءُ انْشَقَّتْ"}]},{"verse_key":"84:2","translations":[{"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"}]},{"verse_key":"84:3","translations":[{"text":"وَإِذَا الْأَرْضُ مُدَّتْ"}]},{"verse_key":"84:4","translations":[{"text":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"}]},{"verse_key":"84:5","translations":[{"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"}]},{"verse_key":"84:6","translations":[{"text":"يَا أَيُّهَا الْإِنْسَانُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَاقِيهِ"}]},{"verse_key":"84:7","translations":[{"text":"فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ"}]},{"verse_key":"84:8","translations":[{"text":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا"}]},{"verse_key":"84:9","translations":[{"text":"وَيَنْقَلِبُ إِلَىٰ أَهْلِهِ مَسْرُورًا"}]},{"verse_key":"84:10","translations":[{"text":"وَأَمَّا مَنْ أُوتِيَ كِتَابَهُ وَرَاءَ ظَهْرِهِ"}]},{"verse_key":"84:11","translations":[{"text":"فَسَوْفَ يَدْعُو ثُبُورًا"}]},{"verse_key":"84:12","translations":[{"text":"وَيَصْلَىٰ سَعِيرًا"}]},{"verse_key":"84:13","translations":[{"text":"إِنَّهُ كَانَ فِي أَهْلِهِ مَسْرُورًا"}]},{"verse_key":"84:14","translations":[{"text":"إِنَّهُ ظَنَّ أَنْ لَنْ يَحُورَ"}]},{"verse_key":"84:15","translations":[{"text":"بَلَىٰ إِنَّ رَبَّهُ كَانَ بِهِ بَصِيرًا"}]},{"verse_key":"84:16","translations":[{"text":"فَلَا أُقْسِمُ بِالشَّفَقِ"}]},{"verse_key":"84:17","translations":[{"text":"وَاللَّيْلِ وَمَا وَسَقَ"}]},{"verse_key":"84:18","translations":[{"text":"وَالْقَمَرِ إِذَا اتَّسَقَ"}]},{"verse_key":"84:19","translations":[{"text":"لَتَرْكَبُنَّ طَبَقًا عَنْ طَبَقٍ"}]},{"verse_key":"84:20","translations":[{"text":"فَمَا لَهُمْ لَا يُؤْمِنُونَ"}]},{"verse_key":"84:21","translations":[{"text":"وَإِذَا قُرِئَ عَلَيْهِمُ الْقُرْآنُ لَا يَسْجُدُونَ ۩"}]},{"verse_key":"84:22","translations":[{"text":"بَلِ الَّذِينَ كَفَرُوا يُكَذِّبُونَ"}]},{"verse_key":"84:23","translations":[{"text":"وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَ"}]},{"verse_key":"84:24","translations":[{"text":"فَبَشِّرْهُمْ بِعَذَابٍ أَلِيمٍ"}]},{"verse_key":"84:25","translations":[{"text":"إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ"}]}]