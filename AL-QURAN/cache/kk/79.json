[{"verse_key":"79:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالنَّازِعَاتِ غَرْقًا"}]},{"verse_key":"79:2","translations":[{"text":"وَالنَّاشِطَاتِ نَشْطًا"}]},{"verse_key":"79:3","translations":[{"text":"وَالسَّابِحَاتِ سَبْحًا"}]},{"verse_key":"79:4","translations":[{"text":"فَالسَّابِقَاتِ سَبْقًا"}]},{"verse_key":"79:5","translations":[{"text":"فَالْمُدَبِّرَاتِ أَمْرًا"}]},{"verse_key":"79:6","translations":[{"text":"يَوْمَ تَرْجُفُ الرَّاجِفَةُ"}]},{"verse_key":"79:7","translations":[{"text":"تَتْبَعُهَا الرَّادِفَةُ"}]},{"verse_key":"79:8","translations":[{"text":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ"}]},{"verse_key":"79:9","translations":[{"text":"أَبْصَارُهَا خَاشِعَةٌ"}]},{"verse_key":"79:10","translations":[{"text":"يَقُولُونَ أَإِنَّا لَمَرْدُودُونَ فِي الْحَافِرَةِ"}]},{"verse_key":"79:11","translations":[{"text":"أَإِذَا كُنَّا عِظَامًا نَخِرَةً"}]},{"verse_key":"79:12","translations":[{"text":"قَالُوا تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ"}]},{"verse_key":"79:13","translations":[{"text":"فَإِنَّمَا هِيَ زَجْرَةٌ وَاحِدَةٌ"}]},{"verse_key":"79:14","translations":[{"text":"فَإِذَا هُمْ بِالسَّاهِرَةِ"}]},{"verse_key":"79:15","translations":[{"text":"هَلْ أَتَاكَ حَدِيثُ مُوسَىٰ"}]},{"verse_key":"79:16","translations":[{"text":"إِذْ نَادَاهُ رَبُّهُ بِالْوَادِ الْمُقَدَّسِ طُوًى"}]},{"verse_key":"79:17","translations":[{"text":"اذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُ طَغَىٰ"}]},{"verse_key":"79:18","translations":[{"text":"فَقُلْ هَلْ لَكَ إِلَىٰ أَنْ تَزَكَّىٰ"}]},{"verse_key":"79:19","translations":[{"text":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ"}]},{"verse_key":"79:20","translations":[{"text":"فَأَرَاهُ الْآيَةَ الْكُبْرَىٰ"}]},{"verse_key":"79:21","translations":[{"text":"فَكَذَّبَ وَعَصَىٰ"}]},{"verse_key":"79:22","translations":[{"text":"ثُمَّ أَدْبَرَ يَسْعَىٰ"}]},{"verse_key":"79:23","translations":[{"text":"فَحَشَرَ فَنَادَىٰ"}]},{"verse_key":"79:24","translations":[{"text":"فَقَالَ أَنَا رَبُّكُمُ الْأَعْلَىٰ"}]},{"verse_key":"79:25","translations":[{"text":"فَأَخَذَهُ اللَّهُ نَكَالَ الْآخِرَةِ وَالْأُولَىٰ"}]},{"verse_key":"79:26","translations":[{"text":"إِنَّ فِي ذَٰلِكَ لَعِبْرَةً لِمَنْ يَخْشَىٰ"}]},{"verse_key":"79:27","translations":[{"text":"أَأَنْتُمْ أَشَدُّ خَلْقًا أَمِ السَّمَاءُ ۚ بَنَاهَا"}]},{"verse_key":"79:28","translations":[{"text":"رَفَعَ سَمْكَهَا فَسَوَّاهَا"}]},{"verse_key":"79:29","translations":[{"text":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَاهَا"}]},{"verse_key":"79:30","translations":[{"text":"وَالْأَرْضَ بَعْدَ ذَٰلِكَ دَحَاهَا"}]},{"verse_key":"79:31","translations":[{"text":"أَخْرَجَ مِنْهَا مَاءَهَا وَمَرْعَاهَا"}]},{"verse_key":"79:32","translations":[{"text":"وَالْجِبَالَ أَرْسَاهَا"}]},{"verse_key":"79:33","translations":[{"text":"مَتَاعًا لَكُمْ وَلِأَنْعَامِكُمْ"}]},{"verse_key":"79:34","translations":[{"text":"فَإِذَا جَاءَتِ الطَّامَّةُ الْكُبْرَىٰ"}]},{"verse_key":"79:35","translations":[{"text":"يَوْمَ يَتَذَكَّرُ الْإِنْسَانُ مَا سَعَىٰ"}]},{"verse_key":"79:36","translations":[{"text":"وَبُرِّزَتِ الْجَحِيمُ لِمَنْ يَرَىٰ"}]},{"verse_key":"79:37","translations":[{"text":"فَأَمَّا مَنْ طَغَىٰ"}]},{"verse_key":"79:38","translations":[{"text":"وَآثَرَ الْحَيَاةَ الدُّنْيَا"}]},{"verse_key":"79:39","translations":[{"text":"فَإِنَّ الْجَحِيمَ هِيَ الْمَأْوَىٰ"}]},{"verse_key":"79:40","translations":[{"text":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِ وَنَهَى النَّفْسَ عَنِ الْهَوَىٰ"}]},{"verse_key":"79:41","translations":[{"text":"فَإِنَّ الْجَنَّةَ هِيَ الْمَأْوَىٰ"}]},{"verse_key":"79:42","translations":[{"text":"يَسْأَلُونَكَ عَنِ السَّاعَةِ أَيَّانَ مُرْسَاهَا"}]},{"verse_key":"79:43","translations":[{"text":"فِيمَ أَنْتَ مِنْ ذِكْرَاهَا"}]},{"verse_key":"79:44","translations":[{"text":"إِلَىٰ رَبِّكَ مُنْتَهَاهَا"}]},{"verse_key":"79:45","translations":[{"text":"إِنَّمَا أَنْتَ مُنْذِرُ مَنْ يَخْشَاهَا"}]},{"verse_key":"79:46","translations":[{"text":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوا إِلَّا عَشِيَّةً أَوْ ضُحَاهَا"}]}]