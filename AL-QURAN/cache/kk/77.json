[{"verse_key":"77:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالْمُرْسَلَاتِ عُرْفًا"}]},{"verse_key":"77:2","translations":[{"text":"فَالْعَاصِفَاتِ عَصْفًا"}]},{"verse_key":"77:3","translations":[{"text":"وَالنَّاشِرَاتِ نَشْرًا"}]},{"verse_key":"77:4","translations":[{"text":"فَالْفَارِقَاتِ فَرْقًا"}]},{"verse_key":"77:5","translations":[{"text":"فَالْمُلْقِيَاتِ ذِكْرًا"}]},{"verse_key":"77:6","translations":[{"text":"عُذْرًا أَوْ نُذْرًا"}]},{"verse_key":"77:7","translations":[{"text":"إِنَّمَا تُوعَدُونَ لَوَاقِعٌ"}]},{"verse_key":"77:8","translations":[{"text":"فَإِذَا النُّجُومُ طُمِسَتْ"}]},{"verse_key":"77:9","translations":[{"text":"وَإِذَا السَّمَاءُ فُرِجَتْ"}]},{"verse_key":"77:10","translations":[{"text":"وَإِذَا الْجِبَالُ نُسِفَتْ"}]},{"verse_key":"77:11","translations":[{"text":"وَإِذَا الرُّسُلُ أُقِّتَتْ"}]},{"verse_key":"77:12","translations":[{"text":"لِأَيِّ يَوْمٍ أُجِّلَتْ"}]},{"verse_key":"77:13","translations":[{"text":"لِيَوْمِ الْفَصْلِ"}]},{"verse_key":"77:14","translations":[{"text":"وَمَا أَدْرَاكَ مَا يَوْمُ الْفَصْلِ"}]},{"verse_key":"77:15","translations":[{"text":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"}]},{"verse_key":"77:16","translations":[{"text":"أَلَمْ نُهْلِكِ الْأَوَّلِينَ"}]},{"verse_key":"77:17","translations":[{"text":"ثُمَّ نُتْبِعُهُمُ الْآخِرِينَ"}]},{"verse_key":"77:18","translations":[{"text":"كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَ"}]},{"verse_key":"77:19","translations":[{"text":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"}]},{"verse_key":"77:20","translations":[{"text":"أَلَمْ نَخْلُقْكُمْ مِنْ مَاءٍ مَهِينٍ"}]},{"verse_key":"77:21","translations":[{"text":"فَجَعَلْنَاهُ فِي قَرَارٍ مَكِينٍ"}]},{"verse_key":"77:22","translations":[{"text":"إِلَىٰ قَدَرٍ مَعْلُومٍ"}]},{"verse_key":"77:23","translations":[{"text":"فَقَدَرْنَا فَنِعْمَ الْقَادِرُونَ"}]},{"verse_key":"77:24","translations":[{"text":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"}]},{"verse_key":"77:25","translations":[{"text":"أَلَمْ نَجْعَلِ الْأَرْضَ كِفَاتًا"}]},{"verse_key":"77:26","translations":[{"text":"أَحْيَاءً وَأَمْوَاتًا"}]},{"verse_key":"77:27","translations":[{"text":"وَجَعَلْنَا فِيهَا رَوَاسِيَ شَامِخَاتٍ وَأَسْقَيْنَاكُمْ مَاءً فُرَاتًا"}]},{"verse_key":"77:28","translations":[{"text":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"}]},{"verse_key":"77:29","translations":[{"text":"انْطَلِقُوا إِلَىٰ مَا كُنْتُمْ بِهِ تُكَذِّبُونَ"}]},{"verse_key":"77:30","translations":[{"text":"انْطَلِقُوا إِلَىٰ ظِلٍّ ذِي ثَلَاثِ شُعَبٍ"}]},{"verse_key":"77:31","translations":[{"text":"لَا ظَلِيلٍ وَلَا يُغْنِي مِنَ اللَّهَبِ"}]},{"verse_key":"77:32","translations":[{"text":"إِنَّهَا تَرْمِي بِشَرَرٍ كَالْقَصْرِ"}]},{"verse_key":"77:33","translations":[{"text":"كَأَنَّهُ جِمَالَتٌ صُفْرٌ"}]},{"verse_key":"77:34","translations":[{"text":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"}]},{"verse_key":"77:35","translations":[{"text":"هَٰذَا يَوْمُ لَا يَنْطِقُونَ"}]},{"verse_key":"77:36","translations":[{"text":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ"}]},{"verse_key":"77:37","translations":[{"text":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"}]},{"verse_key":"77:38","translations":[{"text":"هَٰذَا يَوْمُ الْفَصْلِ ۖ جَمَعْنَاكُمْ وَالْأَوَّلِينَ"}]},{"verse_key":"77:39","translations":[{"text":"فَإِنْ كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ"}]},{"verse_key":"77:40","translations":[{"text":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"}]},{"verse_key":"77:41","translations":[{"text":"إِنَّ الْمُتَّقِينَ فِي ظِلَالٍ وَعُيُونٍ"}]},{"verse_key":"77:42","translations":[{"text":"وَفَوَاكِهَ مِمَّا يَشْتَهُونَ"}]},{"verse_key":"77:43","translations":[{"text":"كُلُوا وَاشْرَبُوا هَنِيئًا بِمَا كُنْتُمْ تَعْمَلُونَ"}]},{"verse_key":"77:44","translations":[{"text":"إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ"}]},{"verse_key":"77:45","translations":[{"text":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"}]},{"verse_key":"77:46","translations":[{"text":"كُلُوا وَتَمَتَّعُوا قَلِيلًا إِنَّكُمْ مُجْرِمُونَ"}]},{"verse_key":"77:47","translations":[{"text":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"}]},{"verse_key":"77:48","translations":[{"text":"وَإِذَا قِيلَ لَهُمُ ارْكَعُوا لَا يَرْكَعُونَ"}]},{"verse_key":"77:49","translations":[{"text":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"}]},{"verse_key":"77:50","translations":[{"text":"فَبِأَيِّ حَدِيثٍ بَعْدَهُ يُؤْمِنُونَ"}]}]