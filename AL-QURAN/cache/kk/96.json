[{"verse_key":"96:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ"}]},{"verse_key":"96:2","translations":[{"text":"خَلَقَ الْإِنْسَانَ مِنْ عَلَقٍ"}]},{"verse_key":"96:3","translations":[{"text":"اقْرَأْ وَرَبُّكَ الْأَكْرَمُ"}]},{"verse_key":"96:4","translations":[{"text":"الَّذِي عَلَّمَ بِالْقَلَمِ"}]},{"verse_key":"96:5","translations":[{"text":"عَلَّمَ الْإِنْسَانَ مَا لَمْ يَعْلَمْ"}]},{"verse_key":"96:6","translations":[{"text":"كَلَّا إِنَّ الْإِنْسَانَ لَيَطْغَىٰ"}]},{"verse_key":"96:7","translations":[{"text":"أَنْ رَآهُ اسْتَغْنَىٰ"}]},{"verse_key":"96:8","translations":[{"text":"إِنَّ إِلَىٰ رَبِّكَ الرُّجْعَىٰ"}]},{"verse_key":"96:9","translations":[{"text":"أَرَأَيْتَ الَّذِي يَنْهَىٰ"}]},{"verse_key":"96:10","translations":[{"text":"عَبْدًا إِذَا صَلَّىٰ"}]},{"verse_key":"96:11","translations":[{"text":"أَرَأَيْتَ إِنْ كَانَ عَلَى الْهُدَىٰ"}]},{"verse_key":"96:12","translations":[{"text":"أَوْ أَمَرَ بِالتَّقْوَىٰ"}]},{"verse_key":"96:13","translations":[{"text":"أَرَأَيْتَ إِنْ كَذَّبَ وَتَوَلَّىٰ"}]},{"verse_key":"96:14","translations":[{"text":"أَلَمْ يَعْلَمْ بِأَنَّ اللَّهَ يَرَىٰ"}]},{"verse_key":"96:15","translations":[{"text":"كَلَّا لَئِنْ لَمْ يَنْتَهِ لَنَسْفَعًا بِالنَّاصِيَةِ"}]},{"verse_key":"96:16","translations":[{"text":"نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍ"}]},{"verse_key":"96:17","translations":[{"text":"فَلْيَدْعُ نَادِيَهُ"}]},{"verse_key":"96:18","translations":[{"text":"سَنَدْعُ الزَّبَانِيَةَ"}]},{"verse_key":"96:19","translations":[{"text":"كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ ۩"}]}]