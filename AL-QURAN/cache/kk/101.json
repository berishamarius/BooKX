[{"verse_key":"101:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الْقَارِعَةُ"}]},{"verse_key":"101:2","translations":[{"text":"مَا الْقَارِعَةُ"}]},{"verse_key":"101:3","translations":[{"text":"وَمَا أَدْرَاكَ مَا الْقَارِعَةُ"}]},{"verse_key":"101:4","translations":[{"text":"يَوْمَ يَكُونُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوثِ"}]},{"verse_key":"101:5","translations":[{"text":"وَتَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوشِ"}]},{"verse_key":"101:6","translations":[{"text":"فَأَمَّا مَنْ ثَقُلَتْ مَوَازِينُهُ"}]},{"verse_key":"101:7","translations":[{"text":"فَهُوَ فِي عِيشَةٍ رَاضِيَةٍ"}]},{"verse_key":"101:8","translations":[{"text":"وَأَمَّا مَنْ خَفَّتْ مَوَازِينُهُ"}]},{"verse_key":"101:9","translations":[{"text":"فَأُمُّهُ هَاوِيَةٌ"}]},{"verse_key":"101:10","translations":[{"text":"وَمَا أَدْرَاكَ مَا هِيَهْ"}]},{"verse_key":"101:11","translations":[{"text":"نَارٌ حَامِيَةٌ"}]}]