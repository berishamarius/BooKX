[{"verse_key":"78:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ عَمَّ يَتَسَاءَلُونَ"}]},{"verse_key":"78:2","translations":[{"text":"عَنِ النَّبَإِ الْعَظِيمِ"}]},{"verse_key":"78:3","translations":[{"text":"الَّذِي هُمْ فِيهِ مُخْتَلِفُونَ"}]},{"verse_key":"78:4","translations":[{"text":"كَلَّا سَيَعْلَمُونَ"}]},{"verse_key":"78:5","translations":[{"text":"ثُمَّ كَلَّا سَيَعْلَمُونَ"}]},{"verse_key":"78:6","translations":[{"text":"أَلَمْ نَجْعَلِ الْأَرْضَ مِهَادًا"}]},{"verse_key":"78:7","translations":[{"text":"وَالْجِبَالَ أَوْتَادًا"}]},{"verse_key":"78:8","translations":[{"text":"وَخَلَقْنَاكُمْ أَزْوَاجًا"}]},{"verse_key":"78:9","translations":[{"text":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا"}]},{"verse_key":"78:10","translations":[{"text":"وَجَعَلْنَا اللَّيْلَ لِبَاسًا"}]},{"verse_key":"78:11","translations":[{"text":"وَجَعَلْنَا النَّهَارَ مَعَاشًا"}]},{"verse_key":"78:12","translations":[{"text":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا"}]},{"verse_key":"78:13","translations":[{"text":"وَجَعَلْنَا سِرَاجًا وَهَّاجًا"}]},{"verse_key":"78:14","translations":[{"text":"وَأَنْزَلْنَا مِنَ الْمُعْصِرَاتِ مَاءً ثَجَّاجًا"}]},{"verse_key":"78:15","translations":[{"text":"لِنُخْرِجَ بِهِ حَبًّا وَنَبَاتًا"}]},{"verse_key":"78:16","translations":[{"text":"وَجَنَّاتٍ أَلْفَافًا"}]},{"verse_key":"78:17","translations":[{"text":"إِنَّ يَوْمَ الْفَصْلِ كَانَ مِيقَاتًا"}]},{"verse_key":"78:18","translations":[{"text":"يَوْمَ يُنْفَخُ فِي الصُّورِ فَتَأْتُونَ أَفْوَاجًا"}]},{"verse_key":"78:19","translations":[{"text":"وَفُتِحَتِ السَّمَاءُ فَكَانَتْ أَبْوَابًا"}]},{"verse_key":"78:20","translations":[{"text":"وَسُيِّرَتِ الْجِبَالُ فَكَانَتْ سَرَابًا"}]},{"verse_key":"78:21","translations":[{"text":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا"}]},{"verse_key":"78:22","translations":[{"text":"لِلطَّاغِينَ مَآبًا"}]},{"verse_key":"78:23","translations":[{"text":"لَابِثِينَ فِيهَا أَحْقَابًا"}]},{"verse_key":"78:24","translations":[{"text":"لَا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا"}]},{"verse_key":"78:25","translations":[{"text":"إِلَّا حَمِيمًا وَغَسَّاقًا"}]},{"verse_key":"78:26","translations":[{"text":"جَزَاءً وِفَاقًا"}]},{"verse_key":"78:27","translations":[{"text":"إِنَّهُمْ كَانُوا لَا يَرْجُونَ حِسَابًا"}]},{"verse_key":"78:28","translations":[{"text":"وَكَذَّبُوا بِآيَاتِنَا كِذَّابًا"}]},{"verse_key":"78:29","translations":[{"text":"وَكُلَّ شَيْءٍ أَحْصَيْنَاهُ كِتَابًا"}]},{"verse_key":"78:30","translations":[{"text":"فَذُوقُوا فَلَنْ نَزِيدَكُمْ إِلَّا عَذَابًا"}]},{"verse_key":"78:31","translations":[{"text":"إِنَّ لِلْمُتَّقِينَ مَفَازًا"}]},{"verse_key":"78:32","translations":[{"text":"حَدَائِقَ وَأَعْنَابًا"}]},{"verse_key":"78:33","translations":[{"text":"وَكَوَاعِبَ أَتْرَابًا"}]},{"verse_key":"78:34","translations":[{"text":"وَكَأْسًا دِهَاقًا"}]},{"verse_key":"78:35","translations":[{"text":"لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّابًا"}]},{"verse_key":"78:36","translations":[{"text":"جَزَاءً مِنْ رَبِّكَ عَطَاءً حِسَابًا"}]},{"verse_key":"78:37","translations":[{"text":"رَبِّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا الرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا"}]},{"verse_key":"78:38","translations":[{"text":"يَوْمَ يَقُومُ الرُّوحُ وَالْمَلَائِكَةُ صَفًّا ۖ لَا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ الرَّحْمَٰنُ وَقَالَ صَوَابًا"}]},{"verse_key":"78:39","translations":[{"text":"ذَٰلِكَ الْيَوْمُ الْحَقُّ ۖ فَمَنْ شَاءَ اتَّخَذَ إِلَىٰ رَبِّهِ مَآبًا"}]},{"verse_key":"78:40","translations":[{"text":"إِنَّا أَنْذَرْنَاكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنْظُرُ الْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ الْكَافِرُ يَا لَيْتَنِي كُنْتُ تُرَابًا"}]}]