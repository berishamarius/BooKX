[{"verse_key":"75:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ لَا أُقْسِمُ بِيَوْمِ الْقِيَامَةِ"}]},{"verse_key":"75:2","translations":[{"text":"وَلَا أُقْسِمُ بِالنَّفْسِ اللَّوَّامَةِ"}]},{"verse_key":"75:3","translations":[{"text":"أَيَحْسَبُ الْإِنْسَانُ أَلَّنْ نَجْمَعَ عِظَامَهُ"}]},{"verse_key":"75:4","translations":[{"text":"بَلَىٰ قَادِرِينَ عَلَىٰ أَنْ نُسَوِّيَ بَنَانَهُ"}]},{"verse_key":"75:5","translations":[{"text":"بَلْ يُرِيدُ الْإِنْسَانُ لِيَفْجُرَ أَمَامَهُ"}]},{"verse_key":"75:6","translations":[{"text":"يَسْأَلُ أَيَّانَ يَوْمُ الْقِيَامَةِ"}]},{"verse_key":"75:7","translations":[{"text":"فَإِذَا بَرِقَ الْبَصَرُ"}]},{"verse_key":"75:8","translations":[{"text":"وَخَسَفَ الْقَمَرُ"}]},{"verse_key":"75:9","translations":[{"text":"وَجُمِعَ الشَّمْسُ وَالْقَمَرُ"}]},{"verse_key":"75:10","translations":[{"text":"يَقُولُ الْإِنْسَانُ يَوْمَئِذٍ أَيْنَ الْمَفَرُّ"}]},{"verse_key":"75:11","translations":[{"text":"كَلَّا لَا وَزَرَ"}]},{"verse_key":"75:12","translations":[{"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ الْمُسْتَقَرُّ"}]},{"verse_key":"75:13","translations":[{"text":"يُنَبَّأُ الْإِنْسَانُ يَوْمَئِذٍ بِمَا قَدَّمَ وَأَخَّرَ"}]},{"verse_key":"75:14","translations":[{"text":"بَلِ الْإِنْسَانُ عَلَىٰ نَفْسِهِ بَصِيرَةٌ"}]},{"verse_key":"75:15","translations":[{"text":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُ"}]},{"verse_key":"75:16","translations":[{"text":"لَا تُحَرِّكْ بِهِ لِسَانَكَ لِتَعْجَلَ بِهِ"}]},{"verse_key":"75:17","translations":[{"text":"إِنَّ عَلَيْنَا جَمْعَهُ وَقُرْآنَهُ"}]},{"verse_key":"75:18","translations":[{"text":"فَإِذَا قَرَأْنَاهُ فَاتَّبِعْ قُرْآنَهُ"}]},{"verse_key":"75:19","translations":[{"text":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُ"}]},{"verse_key":"75:20","translations":[{"text":"كَلَّا بَلْ تُحِبُّونَ الْعَاجِلَةَ"}]},{"verse_key":"75:21","translations":[{"text":"وَتَذَرُونَ الْآخِرَةَ"}]},{"verse_key":"75:22","translations":[{"text":"وُجُوهٌ يَوْمَئِذٍ نَاضِرَةٌ"}]},{"verse_key":"75:23","translations":[{"text":"إِلَىٰ رَبِّهَا نَاظِرَةٌ"}]},{"verse_key":"75:24","translations":[{"text":"وَوُجُوهٌ يَوْمَئِذٍ بَاسِرَةٌ"}]},{"verse_key":"75:25","translations":[{"text":"تَظُنُّ أَنْ يُفْعَلَ بِهَا فَاقِرَةٌ"}]},{"verse_key":"75:26","translations":[{"text":"كَلَّا إِذَا بَلَغَتِ التَّرَاقِيَ"}]},{"verse_key":"75:27","translations":[{"text":"وَقِيلَ مَنْ ۜ رَاقٍ"}]},{"verse_key":"75:28","translations":[{"text":"وَظَنَّ أَنَّهُ الْفِرَاقُ"}]},{"verse_key":"75:29","translations":[{"text":"وَالْتَفَّتِ السَّاقُ بِالسَّاقِ"}]},{"verse_key":"75:30","translations":[{"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ الْمَسَاقُ"}]},{"verse_key":"75:31","translations":[{"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ"}]},{"verse_key":"75:32","translations":[{"text":"وَلَٰكِنْ كَذَّبَ وَتَوَلَّىٰ"}]},{"verse_key":"75:33","translations":[{"text":"ثُمَّ ذَهَبَ إِلَىٰ أَهْلِهِ يَتَمَطَّىٰ"}]},{"verse_key":"75:34","translations":[{"text":"أَوْلَىٰ لَكَ فَأَوْلَىٰ"}]},{"verse_key":"75:35","translations":[{"text":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰ"}]},{"verse_key":"75:36","translations":[{"text":"أَيَحْسَبُ الْإِنْسَانُ أَنْ يُتْرَكَ سُدًى"}]},{"verse_key":"75:37","translations":[{"text":"أَلَمْ يَكُ نُطْفَةً مِنْ مَنِيٍّ يُمْنَىٰ"}]},{"verse_key":"75:38","translations":[{"text":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ"}]},{"verse_key":"75:39","translations":[{"text":"فَجَعَلَ مِنْهُ الزَّوْجَيْنِ الذَّكَرَ وَالْأُنْثَىٰ"}]},{"verse_key":"75:40","translations":[{"text":"أَلَيْسَ ذَٰلِكَ بِقَادِرٍ عَلَىٰ أَنْ يُحْيِيَ الْمَوْتَىٰ"}]}]