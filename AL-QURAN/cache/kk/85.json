[{"verse_key":"85:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالسَّمَاءِ ذَاتِ الْبُرُوجِ"}]},{"verse_key":"85:2","translations":[{"text":"وَالْيَوْمِ الْمَوْعُودِ"}]},{"verse_key":"85:3","translations":[{"text":"وَشَاهِدٍ وَمَشْهُودٍ"}]},{"verse_key":"85:4","translations":[{"text":"قُتِلَ أَصْحَابُ الْأُخْدُودِ"}]},{"verse_key":"85:5","translations":[{"text":"النَّارِ ذَاتِ الْوَقُودِ"}]},{"verse_key":"85:6","translations":[{"text":"إِذْ هُمْ عَلَيْهَا قُعُودٌ"}]},{"verse_key":"85:7","translations":[{"text":"وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِالْمُؤْمِنِينَ شُهُودٌ"}]},{"verse_key":"85:8","translations":[{"text":"وَمَا نَقَمُوا مِنْهُمْ إِلَّا أَنْ يُؤْمِنُوا بِاللَّهِ الْعَزِيزِ الْحَمِيدِ"}]},{"verse_key":"85:9","translations":[{"text":"الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ ۚ وَاللَّهُ عَلَىٰ كُلِّ شَيْءٍ شَهِيدٌ"}]},{"verse_key":"85:10","translations":[{"text":"إِنَّ الَّذِينَ فَتَنُوا الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ ثُمَّ لَمْ يَتُوبُوا فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ الْحَرِيقِ"}]},{"verse_key":"85:11","translations":[{"text":"إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ جَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ ۚ ذَٰلِكَ الْفَوْزُ الْكَبِيرُ"}]},{"verse_key":"85:12","translations":[{"text":"إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ"}]},{"verse_key":"85:13","translations":[{"text":"إِنَّهُ هُوَ يُبْدِئُ وَيُعِيدُ"}]},{"verse_key":"85:14","translations":[{"text":"وَهُوَ الْغَفُورُ الْوَدُودُ"}]},{"verse_key":"85:15","translations":[{"text":"ذُو الْعَرْشِ الْمَجِيدُ"}]},{"verse_key":"85:16","translations":[{"text":"فَعَّالٌ لِمَا يُرِيدُ"}]},{"verse_key":"85:17","translations":[{"text":"هَلْ أَتَاكَ حَدِيثُ الْجُنُودِ"}]},{"verse_key":"85:18","translations":[{"text":"فِرْعَوْنَ وَثَمُودَ"}]},{"verse_key":"85:19","translations":[{"text":"بَلِ الَّذِينَ كَفَرُوا فِي تَكْذِيبٍ"}]},{"verse_key":"85:20","translations":[{"text":"وَاللَّهُ مِنْ وَرَائِهِمْ مُحِيطٌ"}]},{"verse_key":"85:21","translations":[{"text":"بَلْ هُوَ قُرْآنٌ مَجِيدٌ"}]},{"verse_key":"85:22","translations":[{"text":"فِي لَوْحٍ مَحْفُوظٍ"}]}]