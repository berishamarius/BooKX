[{"verse_key":"91:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالشَّمْسِ وَضُحَاهَا"}]},{"verse_key":"91:2","translations":[{"text":"وَالْقَمَرِ إِذَا تَلَاهَا"}]},{"verse_key":"91:3","translations":[{"text":"وَالنَّهَارِ إِذَا جَلَّاهَا"}]},{"verse_key":"91:4","translations":[{"text":"وَاللَّيْلِ إِذَا يَغْشَاهَا"}]},{"verse_key":"91:5","translations":[{"text":"وَالسَّمَاءِ وَمَا بَنَاهَا"}]},{"verse_key":"91:6","translations":[{"text":"وَالْأَرْضِ وَمَا طَحَاهَا"}]},{"verse_key":"91:7","translations":[{"text":"وَنَفْسٍ وَمَا سَوَّاهَا"}]},{"verse_key":"91:8","translations":[{"text":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَاهَا"}]},{"verse_key":"91:9","translations":[{"text":"قَدْ أَفْلَحَ مَنْ زَكَّاهَا"}]},{"verse_key":"91:10","translations":[{"text":"وَقَدْ خَابَ مَنْ دَسَّاهَا"}]},{"verse_key":"91:11","translations":[{"text":"كَذَّبَتْ ثَمُودُ بِطَغْوَاهَا"}]},{"verse_key":"91:12","translations":[{"text":"إِذِ انْبَعَثَ أَشْقَاهَا"}]},{"verse_key":"91:13","translations":[{"text":"فَقَالَ لَهُمْ رَسُولُ اللَّهِ نَاقَةَ اللَّهِ وَسُقْيَاهَا"}]},{"verse_key":"91:14","translations":[{"text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُمْ بِذَنْبِهِمْ فَسَوَّاهَا"}]},{"verse_key":"91:15","translations":[{"text":"وَلَا يَخَافُ عُقْبَاهَا"}]}]