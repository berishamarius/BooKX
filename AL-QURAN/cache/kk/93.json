[{"verse_key":"93:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالضُّحَىٰ"}]},{"verse_key":"93:2","translations":[{"text":"وَاللَّيْلِ إِذَا سَجَىٰ"}]},{"verse_key":"93:3","translations":[{"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"}]},{"verse_key":"93:4","translations":[{"text":"وَلَلْآخِرَةُ خَيْرٌ لَكَ مِنَ الْأُولَىٰ"}]},{"verse_key":"93:5","translations":[{"text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ"}]},{"verse_key":"93:6","translations":[{"text":"أَلَمْ يَجِدْكَ يَتِيمًا فَآوَىٰ"}]},{"verse_key":"93:7","translations":[{"text":"وَوَجَدَكَ ضَالًّا فَهَدَىٰ"}]},{"verse_key":"93:8","translations":[{"text":"وَوَجَدَكَ عَائِلًا فَأَغْنَىٰ"}]},{"verse_key":"93:9","translations":[{"text":"فَأَمَّا الْيَتِيمَ فَلَا تَقْهَرْ"}]},{"verse_key":"93:10","translations":[{"text":"وَأَمَّا السَّائِلَ فَلَا تَنْهَرْ"}]},{"verse_key":"93:11","translations":[{"text":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"}]}]