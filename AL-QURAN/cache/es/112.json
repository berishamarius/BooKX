[{"verse_key":"112:1","translations":[{"text":"Di: \"Él es Al-lah, Uno."}]},{"verse_key":"112:2","translations":[{"text":"Al-lah es el Absoluto."}]},{"verse_key":"112:3","translations":[{"text":"No engendró ni fue engendrado."}]},{"verse_key":"112:4","translations":[{"text":"Y no hay nada ni nadie que sea semejante a Él\"."}]}]