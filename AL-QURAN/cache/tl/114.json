[{"verse_key":"114:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ النَّاسِ"}]},{"verse_key":"114:2","translations":[{"text":"مَلِكِ النَّاسِ"}]},{"verse_key":"114:3","translations":[{"text":"إِلَٰهِ النَّاسِ"}]},{"verse_key":"114:4","translations":[{"text":"مِنْ شَرِّ الْوَسْوَاسِ الْخَنَّاسِ"}]},{"verse_key":"114:5","translations":[{"text":"الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ"}]},{"verse_key":"114:6","translations":[{"text":"مِنَ الْجِنَّةِ وَالنَّاسِ"}]}]