[{"verse_key":"113:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ"}]},{"verse_key":"113:2","translations":[{"text":"مِنْ شَرِّ مَا خَلَقَ"}]},{"verse_key":"113:3","translations":[{"text":"وَمِنْ شَرِّ غَاسِقٍ إِذَا وَقَبَ"}]},{"verse_key":"113:4","translations":[{"text":"وَمِنْ شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ"}]},{"verse_key":"113:5","translations":[{"text":"وَمِنْ شَرِّ حَاسِدٍ إِذَا حَسَدَ"}]}]