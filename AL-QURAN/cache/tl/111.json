[{"verse_key":"111:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ تَبَّتْ يَدَا أَبِي لَهَبٍ وَتَبَّ"}]},{"verse_key":"111:2","translations":[{"text":"مَا أَغْنَىٰ عَنْهُ مَالُهُ وَمَا كَسَبَ"}]},{"verse_key":"111:3","translations":[{"text":"سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ"}]},{"verse_key":"111:4","translations":[{"text":"وَامْرَأَتُهُ حَمَّالَةَ الْحَطَبِ"}]},{"verse_key":"111:5","translations":[{"text":"فِي جِيدِهَا حَبْلٌ مِنْ مَسَدٍ"}]}]