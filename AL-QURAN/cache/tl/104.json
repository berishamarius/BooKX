[{"verse_key":"104:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَيْلٌ لِكُلِّ هُمَزَةٍ لُمَزَةٍ"}]},{"verse_key":"104:2","translations":[{"text":"الَّذِي جَمَعَ مَالًا وَعَدَّدَهُ"}]},{"verse_key":"104:3","translations":[{"text":"يَحْسَبُ أَنَّ مَالَهُ أَخْلَدَهُ"}]},{"verse_key":"104:4","translations":[{"text":"كَلَّا ۖ لَيُنْبَذَنَّ فِي الْحُطَمَةِ"}]},{"verse_key":"104:5","translations":[{"text":"وَمَا أَدْرَاكَ مَا الْحُطَمَةُ"}]},{"verse_key":"104:6","translations":[{"text":"نَارُ اللَّهِ الْمُوقَدَةُ"}]},{"verse_key":"104:7","translations":[{"text":"الَّتِي تَطَّلِعُ عَلَى الْأَفْئِدَةِ"}]},{"verse_key":"104:8","translations":[{"text":"إِنَّهَا عَلَيْهِمْ مُؤْصَدَةٌ"}]},{"verse_key":"104:9","translations":[{"text":"فِي عَمَدٍ مُمَدَّدَةٍ"}]}]