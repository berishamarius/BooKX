[{"verse_key":"88:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ"}]},{"verse_key":"88:2","translations":[{"text":"وُجُوهٌ يَوْمَئِذٍ خَاشِعَةٌ"}]},{"verse_key":"88:3","translations":[{"text":"عَامِلَةٌ نَاصِبَةٌ"}]},{"verse_key":"88:4","translations":[{"text":"تَصْلَىٰ نَارًا حَامِيَةً"}]},{"verse_key":"88:5","translations":[{"text":"تُسْقَىٰ مِنْ عَيْنٍ آنِيَةٍ"}]},{"verse_key":"88:6","translations":[{"text":"لَيْسَ لَهُمْ طَعَامٌ إِلَّا مِنْ ضَرِيعٍ"}]},{"verse_key":"88:7","translations":[{"text":"لَا يُسْمِنُ وَلَا يُغْنِي مِنْ جُوعٍ"}]},{"verse_key":"88:8","translations":[{"text":"وُجُوهٌ يَوْمَئِذٍ نَاعِمَةٌ"}]},{"verse_key":"88:9","translations":[{"text":"لِسَعْيِهَا رَاضِيَةٌ"}]},{"verse_key":"88:10","translations":[{"text":"فِي جَنَّةٍ عَالِيَةٍ"}]},{"verse_key":"88:11","translations":[{"text":"لَا تَسْمَعُ فِيهَا لَاغِيَةً"}]},{"verse_key":"88:12","translations":[{"text":"فِيهَا عَيْنٌ جَارِيَةٌ"}]},{"verse_key":"88:13","translations":[{"text":"فِيهَا سُرُرٌ مَرْفُوعَةٌ"}]},{"verse_key":"88:14","translations":[{"text":"وَأَكْوَابٌ مَوْضُوعَةٌ"}]},{"verse_key":"88:15","translations":[{"text":"وَنَمَارِقُ مَصْفُوفَةٌ"}]},{"verse_key":"88:16","translations":[{"text":"وَزَرَابِيُّ مَبْثُوثَةٌ"}]},{"verse_key":"88:17","translations":[{"text":"أَفَلَا يَنْظُرُونَ إِلَى الْإِبِلِ كَيْفَ خُلِقَتْ"}]},{"verse_key":"88:18","translations":[{"text":"وَإِلَى السَّمَاءِ كَيْفَ رُفِعَتْ"}]},{"verse_key":"88:19","translations":[{"text":"وَإِلَى الْجِبَالِ كَيْفَ نُصِبَتْ"}]},{"verse_key":"88:20","translations":[{"text":"وَإِلَى الْأَرْضِ كَيْفَ سُطِحَتْ"}]},{"verse_key":"88:21","translations":[{"text":"فَذَكِّرْ إِنَّمَا أَنْتَ مُذَكِّرٌ"}]},{"verse_key":"88:22","translations":[{"text":"لَسْتَ عَلَيْهِمْ بِمُصَيْطِرٍ"}]},{"verse_key":"88:23","translations":[{"text":"إِلَّا مَنْ تَوَلَّىٰ وَكَفَرَ"}]},{"verse_key":"88:24","translations":[{"text":"فَيُعَذِّبُهُ اللَّهُ الْعَذَابَ الْأَكْبَرَ"}]},{"verse_key":"88:25","translations":[{"text":"إِنَّ إِلَيْنَا إِيَابَهُمْ"}]},{"verse_key":"88:26","translations":[{"text":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُمْ"}]}]