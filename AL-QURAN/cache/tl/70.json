[{"verse_key":"70:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ سَأَلَ سَائِلٌ بِعَذَابٍ وَاقِعٍ"}]},{"verse_key":"70:2","translations":[{"text":"لِلْكَافِرِينَ لَيْسَ لَهُ دَافِعٌ"}]},{"verse_key":"70:3","translations":[{"text":"مِنَ اللَّهِ ذِي الْمَعَارِجِ"}]},{"verse_key":"70:4","translations":[{"text":"تَعْرُجُ الْمَلَائِكَةُ وَالرُّوحُ إِلَيْهِ فِي يَوْمٍ كَانَ مِقْدَارُهُ خَمْسِينَ أَلْفَ سَنَةٍ"}]},{"verse_key":"70:5","translations":[{"text":"فَاصْبِرْ صَبْرًا جَمِيلًا"}]},{"verse_key":"70:6","translations":[{"text":"إِنَّهُمْ يَرَوْنَهُ بَعِيدًا"}]},{"verse_key":"70:7","translations":[{"text":"وَنَرَاهُ قَرِيبًا"}]},{"verse_key":"70:8","translations":[{"text":"يَوْمَ تَكُونُ السَّمَاءُ كَالْمُهْلِ"}]},{"verse_key":"70:9","translations":[{"text":"وَتَكُونُ الْجِبَالُ كَالْعِهْنِ"}]},{"verse_key":"70:10","translations":[{"text":"وَلَا يَسْأَلُ حَمِيمٌ حَمِيمًا"}]},{"verse_key":"70:11","translations":[{"text":"يُبَصَّرُونَهُمْ ۚ يَوَدُّ الْمُجْرِمُ لَوْ يَفْتَدِي مِنْ عَذَابِ يَوْمِئِذٍ بِبَنِيهِ"}]},{"verse_key":"70:12","translations":[{"text":"وَصَاحِبَتِهِ وَأَخِيهِ"}]},{"verse_key":"70:13","translations":[{"text":"وَفَصِيلَتِهِ الَّتِي تُؤْوِيهِ"}]},{"verse_key":"70:14","translations":[{"text":"وَمَنْ فِي الْأَرْضِ جَمِيعًا ثُمَّ يُنْجِيهِ"}]},{"verse_key":"70:15","translations":[{"text":"كَلَّا ۖ إِنَّهَا لَظَىٰ"}]},{"verse_key":"70:16","translations":[{"text":"نَزَّاعَةً لِلشَّوَىٰ"}]},{"verse_key":"70:17","translations":[{"text":"تَدْعُو مَنْ أَدْبَرَ وَتَوَلَّىٰ"}]},{"verse_key":"70:18","translations":[{"text":"وَجَمَعَ فَأَوْعَىٰ"}]},{"verse_key":"70:19","translations":[{"text":"۞ إِنَّ الْإِنْسَانَ خُلِقَ هَلُوعًا"}]},{"verse_key":"70:20","translations":[{"text":"إِذَا مَسَّهُ الشَّرُّ جَزُوعًا"}]},{"verse_key":"70:21","translations":[{"text":"وَإِذَا مَسَّهُ الْخَيْرُ مَنُوعًا"}]},{"verse_key":"70:22","translations":[{"text":"إِلَّا الْمُصَلِّينَ"}]},{"verse_key":"70:23","translations":[{"text":"الَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَائِمُونَ"}]},{"verse_key":"70:24","translations":[{"text":"وَالَّذِينَ فِي أَمْوَالِهِمْ حَقٌّ مَعْلُومٌ"}]},{"verse_key":"70:25","translations":[{"text":"لِلسَّائِلِ وَالْمَحْرُومِ"}]},{"verse_key":"70:26","translations":[{"text":"وَالَّذِينَ يُصَدِّقُونَ بِيَوْمِ الدِّينِ"}]},{"verse_key":"70:27","translations":[{"text":"وَالَّذِينَ هُمْ مِنْ عَذَابِ رَبِّهِمْ مُشْفِقُونَ"}]},{"verse_key":"70:28","translations":[{"text":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ"}]},{"verse_key":"70:29","translations":[{"text":"وَالَّذِينَ هُمْ لِفُرُوجِهِمْ حَافِظُونَ"}]},{"verse_key":"70:30","translations":[{"text":"إِلَّا عَلَىٰ أَزْوَاجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَانُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ"}]},{"verse_key":"70:31","translations":[{"text":"فَمَنِ ابْتَغَىٰ وَرَاءَ ذَٰلِكَ فَأُولَٰئِكَ هُمُ الْعَادُونَ"}]},{"verse_key":"70:32","translations":[{"text":"وَالَّذِينَ هُمْ لِأَمَانَاتِهِمْ وَعَهْدِهِمْ رَاعُونَ"}]},{"verse_key":"70:33","translations":[{"text":"وَالَّذِينَ هُمْ بِشَهَادَاتِهِمْ قَائِمُونَ"}]},{"verse_key":"70:34","translations":[{"text":"وَالَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ"}]},{"verse_key":"70:35","translations":[{"text":"أُولَٰئِكَ فِي جَنَّاتٍ مُكْرَمُونَ"}]},{"verse_key":"70:36","translations":[{"text":"فَمَالِ الَّذِينَ كَفَرُوا قِبَلَكَ مُهْطِعِينَ"}]},{"verse_key":"70:37","translations":[{"text":"عَنِ الْيَمِينِ وَعَنِ الشِّمَالِ عِزِينَ"}]},{"verse_key":"70:38","translations":[{"text":"أَيَطْمَعُ كُلُّ امْرِئٍ مِنْهُمْ أَنْ يُدْخَلَ جَنَّةَ نَعِيمٍ"}]},{"verse_key":"70:39","translations":[{"text":"كَلَّا ۖ إِنَّا خَلَقْنَاهُمْ مِمَّا يَعْلَمُونَ"}]},{"verse_key":"70:40","translations":[{"text":"فَلَا أُقْسِمُ بِرَبِّ الْمَشَارِقِ وَالْمَغَارِبِ إِنَّا لَقَادِرُونَ"}]},{"verse_key":"70:41","translations":[{"text":"عَلَىٰ أَنْ نُبَدِّلَ خَيْرًا مِنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ"}]},{"verse_key":"70:42","translations":[{"text":"فَذَرْهُمْ يَخُوضُوا وَيَلْعَبُوا حَتَّىٰ يُلَاقُوا يَوْمَهُمُ الَّذِي يُوعَدُونَ"}]},{"verse_key":"70:43","translations":[{"text":"يَوْمَ يَخْرُجُونَ مِنَ الْأَجْدَاثِ سِرَاعًا كَأَنَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ"}]},{"verse_key":"70:44","translations":[{"text":"خَاشِعَةً أَبْصَارُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۚ ذَٰلِكَ الْيَوْمُ الَّذِي كَانُوا يُوعَدُونَ"}]}]