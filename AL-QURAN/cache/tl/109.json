[{"verse_key":"109:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ قُلْ يَا أَيُّهَا الْكَافِرُونَ"}]},{"verse_key":"109:2","translations":[{"text":"لَا أَعْبُدُ مَا تَعْبُدُونَ"}]},{"verse_key":"109:3","translations":[{"text":"وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ"}]},{"verse_key":"109:4","translations":[{"text":"وَلَا أَنَا عَابِدٌ مَا عَبَدْتُمْ"}]},{"verse_key":"109:5","translations":[{"text":"وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ"}]},{"verse_key":"109:6","translations":[{"text":"لَكُمْ دِينُكُمْ وَلِيَ دِينِ"}]}]