[{"verse_key":"81:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِذَا الشَّمْسُ كُوِّرَتْ"}]},{"verse_key":"81:2","translations":[{"text":"وَإِذَا النُّجُومُ انْكَدَرَتْ"}]},{"verse_key":"81:3","translations":[{"text":"وَإِذَا الْجِبَالُ سُيِّرَتْ"}]},{"verse_key":"81:4","translations":[{"text":"وَإِذَا الْعِشَارُ عُطِّلَتْ"}]},{"verse_key":"81:5","translations":[{"text":"وَإِذَا الْوُحُوشُ حُشِرَتْ"}]},{"verse_key":"81:6","translations":[{"text":"وَإِذَا الْبِحَارُ سُجِّرَتْ"}]},{"verse_key":"81:7","translations":[{"text":"وَإِذَا النُّفُوسُ زُوِّجَتْ"}]},{"verse_key":"81:8","translations":[{"text":"وَإِذَا الْمَوْءُودَةُ سُئِلَتْ"}]},{"verse_key":"81:9","translations":[{"text":"بِأَيِّ ذَنْبٍ قُتِلَتْ"}]},{"verse_key":"81:10","translations":[{"text":"وَإِذَا الصُّحُفُ نُشِرَتْ"}]},{"verse_key":"81:11","translations":[{"text":"وَإِذَا السَّمَاءُ كُشِطَتْ"}]},{"verse_key":"81:12","translations":[{"text":"وَإِذَا الْجَحِيمُ سُعِّرَتْ"}]},{"verse_key":"81:13","translations":[{"text":"وَإِذَا الْجَنَّةُ أُزْلِفَتْ"}]},{"verse_key":"81:14","translations":[{"text":"عَلِمَتْ نَفْسٌ مَا أَحْضَرَتْ"}]},{"verse_key":"81:15","translations":[{"text":"فَلَا أُقْسِمُ بِالْخُنَّسِ"}]},{"verse_key":"81:16","translations":[{"text":"الْجَوَارِ الْكُنَّسِ"}]},{"verse_key":"81:17","translations":[{"text":"وَاللَّيْلِ إِذَا عَسْعَسَ"}]},{"verse_key":"81:18","translations":[{"text":"وَالصُّبْحِ إِذَا تَنَفَّسَ"}]},{"verse_key":"81:19","translations":[{"text":"إِنَّهُ لَقَوْلُ رَسُولٍ كَرِيمٍ"}]},{"verse_key":"81:20","translations":[{"text":"ذِي قُوَّةٍ عِنْدَ ذِي الْعَرْشِ مَكِينٍ"}]},{"verse_key":"81:21","translations":[{"text":"مُطَاعٍ ثَمَّ أَمِينٍ"}]},{"verse_key":"81:22","translations":[{"text":"وَمَا صَاحِبُكُمْ بِمَجْنُونٍ"}]},{"verse_key":"81:23","translations":[{"text":"وَلَقَدْ رَآهُ بِالْأُفُقِ الْمُبِينِ"}]},{"verse_key":"81:24","translations":[{"text":"وَمَا هُوَ عَلَى الْغَيْبِ بِضَنِينٍ"}]},{"verse_key":"81:25","translations":[{"text":"وَمَا هُوَ بِقَوْلِ شَيْطَانٍ رَجِيمٍ"}]},{"verse_key":"81:26","translations":[{"text":"فَأَيْنَ تَذْهَبُونَ"}]},{"verse_key":"81:27","translations":[{"text":"إِنْ هُوَ إِلَّا ذِكْرٌ لِلْعَالَمِينَ"}]},{"verse_key":"81:28","translations":[{"text":"لِمَنْ شَاءَ مِنْكُمْ أَنْ يَسْتَقِيمَ"}]},{"verse_key":"81:29","translations":[{"text":"وَمَا تَشَاءُونَ إِلَّا أَنْ يَشَاءَ اللَّهُ رَبُّ الْعَالَمِينَ"}]}]