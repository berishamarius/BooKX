[{"verse_key":"94:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ"}]},{"verse_key":"94:2","translations":[{"text":"وَوَضَعْنَا عَنْكَ وِزْرَكَ"}]},{"verse_key":"94:3","translations":[{"text":"الَّذِي أَنْقَضَ ظَهْرَكَ"}]},{"verse_key":"94:4","translations":[{"text":"وَرَفَعْنَا لَكَ ذِكْرَكَ"}]},{"verse_key":"94:5","translations":[{"text":"فَإِنَّ مَعَ الْعُسْرِ يُسْرًا"}]},{"verse_key":"94:6","translations":[{"text":"إِنَّ مَعَ الْعُسْرِ يُسْرًا"}]},{"verse_key":"94:7","translations":[{"text":"فَإِذَا فَرَغْتَ فَانْصَبْ"}]},{"verse_key":"94:8","translations":[{"text":"وَإِلَىٰ رَبِّكَ فَارْغَبْ"}]}]