[{"verse_key":"100:1","translations":[{"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالْعَادِيَاتِ ضَبْحًا"}]},{"verse_key":"100:2","translations":[{"text":"فَالْمُورِيَاتِ قَدْحًا"}]},{"verse_key":"100:3","translations":[{"text":"فَالْمُغِيرَاتِ صُبْحًا"}]},{"verse_key":"100:4","translations":[{"text":"فَأَثَرْنَ بِهِ نَقْعًا"}]},{"verse_key":"100:5","translations":[{"text":"فَوَسَطْنَ بِهِ جَمْعًا"}]},{"verse_key":"100:6","translations":[{"text":"إِنَّ الْإِنْسَانَ لِرَبِّهِ لَكَنُودٌ"}]},{"verse_key":"100:7","translations":[{"text":"وَإِنَّهُ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ"}]},{"verse_key":"100:8","translations":[{"text":"وَإِنَّهُ لِحُبِّ الْخَيْرِ لَشَدِيدٌ"}]},{"verse_key":"100:9","translations":[{"text":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِي الْقُبُورِ"}]},{"verse_key":"100:10","translations":[{"text":"وَحُصِّلَ مَا فِي الصُّدُورِ"}]},{"verse_key":"100:11","translations":[{"text":"إِنَّ رَبَّهُمْ بِهِمْ يَوْمَئِذٍ لَخَبِيرٌ"}]}]