[{"verse_key":"80:1","translations":[{"text":"Он нахмурился и отвернулся;"}]},{"verse_key":"80:2","translations":[{"text":"Потому что к нему пришел слепой."}]},{"verse_key":"80:3","translations":[{"text":"О если бы что нибудь вразумило тебя в том, что он может быть чистым,"}]},{"verse_key":"80:4","translations":[{"text":"Или, примет наставление, и наставление это принесет ему пользу!"}]},{"verse_key":"80:5","translations":[{"text":"Кто богат,"}]},{"verse_key":"80:6","translations":[{"text":"Того ты принимаешь ласково,"}]},{"verse_key":"80:7","translations":[{"text":"Тогда как не от тебя зависит, если он не сделается чистым."}]},{"verse_key":"80:8","translations":[{"text":"Кто же к тебе приходит с усердием,"}]},{"verse_key":"80:9","translations":[{"text":"И будучи богобоязлив,"}]},{"verse_key":"80:10","translations":[{"text":"На того ты не обращаешь внимание."}]},{"verse_key":"80:11","translations":[{"text":"Не так. Это тебе предостережение."}]},{"verse_key":"80:12","translations":[{"text":"Кто захочет, тот будет помнить его."}]},{"verse_key":"80:13","translations":[{"text":"Он на свитках, досточтимых,"}]},{"verse_key":"80:14","translations":[{"text":"Высоких, чистых,"}]},{"verse_key":"80:15","translations":[{"text":"Начертанных руками писцев"}]},{"verse_key":"80:16","translations":[{"text":"сановитых, праведных."}]},{"verse_key":"80:17","translations":[{"text":"Да будет поражен человек! Как неблагодарен он!"}]},{"verse_key":"80:18","translations":[{"text":"Из чего Он творит его?"}]},{"verse_key":"80:19","translations":[{"text":"Из семени. Он творит его, дает соразмерность его членам,"}]},{"verse_key":"80:20","translations":[{"text":"За тем облегчает ему путь,"}]},{"verse_key":"80:21","translations":[{"text":"Потом умерщвляет его и погребает его,"}]},{"verse_key":"80:22","translations":[{"text":"Потом когда захочет, воскресит его."}]},{"verse_key":"80:23","translations":[{"text":"А он не исполняет того, что повелел Он ему."}]},{"verse_key":"80:24","translations":[{"text":"Пусть обратит человек взор свой на то, чем питается он."}]},{"verse_key":"80:25","translations":[{"text":"Мы проливаем воду ливнями,"}]},{"verse_key":"80:26","translations":[{"text":"Потом заставляем землю растрескиваться трещинами,"}]},{"verse_key":"80:27","translations":[{"text":"Выращаем на ней хлеб,"}]},{"verse_key":"80:28","translations":[{"text":"Виноград, овощи,"}]},{"verse_key":"80:29","translations":[{"text":"Маслины, пальмы,"}]},{"verse_key":"80:30","translations":[{"text":"Сады, обильные деревами,"}]},{"verse_key":"80:31","translations":[{"text":"Плоды и злаки,"}]},{"verse_key":"80:32","translations":[{"text":"В продовольствие вам и скоту вашему."}]},{"verse_key":"80:33","translations":[{"text":"Но когда настанет оглушительный трубный звук,"}]},{"verse_key":"80:34","translations":[{"text":"В тот день, когда человек побежит от своего брата,"}]},{"verse_key":"80:35","translations":[{"text":"Своей матери и своего отца,"}]},{"verse_key":"80:36","translations":[{"text":"Своей супруги и своих сыновей:"}]},{"verse_key":"80:37","translations":[{"text":"В этот день для каждого из них будет забота, которая отяготит его."}]},{"verse_key":"80:38","translations":[{"text":"В этот день у некоторых лица будут светлые,"}]},{"verse_key":"80:39","translations":[{"text":"Смеющиеся, веселые;"}]},{"verse_key":"80:40","translations":[{"text":"В этот день у некоторых лица будут запыленные,"}]},{"verse_key":"80:41","translations":[{"text":"Покрытые прахом."}]},{"verse_key":"80:42","translations":[{"text":"Такими будут неверующие, развратные."}]}]