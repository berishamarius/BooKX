[{"verse_key":"88:1","translations":[{"text":"Доходила ли до тебя весть о накрывающем?"}]},{"verse_key":"88:2","translations":[{"text":"В этот день некоторые будут с лицами поникшими,"}]},{"verse_key":"88:3","translations":[{"text":"Томными, унылыми,"}]},{"verse_key":"88:4","translations":[{"text":"Опаляемые жгучим огнем."}]},{"verse_key":"88:5","translations":[{"text":"Питье им будет из сильно кипящего источника;"}]},{"verse_key":"88:6","translations":[{"text":"Пищею им будет только терн дзариг:"}]},{"verse_key":"88:7","translations":[{"text":"Он не утучнит, да и голода не утолит."}]},{"verse_key":"88:8","translations":[{"text":"В этот день некоторые будут с лицами радостными,"}]},{"verse_key":"88:9","translations":[{"text":"Удовлетворяясь своими подвигами,"}]},{"verse_key":"88:10","translations":[{"text":"В горнем рае."}]},{"verse_key":"88:11","translations":[{"text":"В нем не услышишь празднословия:"}]},{"verse_key":"88:12","translations":[{"text":"В нем источник проточный:"}]},{"verse_key":"88:13","translations":[{"text":"В нем седалища высокие,"}]},{"verse_key":"88:14","translations":[{"text":"Кубки расставленные,"}]},{"verse_key":"88:15","translations":[{"text":"Подушки, рядами наложенные,"}]},{"verse_key":"88:16","translations":[{"text":"Ковры разостланные."}]},{"verse_key":"88:17","translations":[{"text":"Уже ли они не обращают взора на верблюдов, как они созданы;"}]},{"verse_key":"88:18","translations":[{"text":"На небо, как оно возвышено;"}]},{"verse_key":"88:19","translations":[{"text":"На горы, как они поставлены;"}]},{"verse_key":"88:20","translations":[{"text":"На землю, как она разостлана?"}]},{"verse_key":"88:21","translations":[{"text":"Учи их; ты их учитель;"}]},{"verse_key":"88:22","translations":[{"text":"Над ними ты не надзиратель."}]},{"verse_key":"88:23","translations":[{"text":"Тех же, которые отворотятся и будут неверующими,"}]},{"verse_key":"88:24","translations":[{"text":"Бог накажет самым великим наказанием."}]},{"verse_key":"88:25","translations":[{"text":"Истинно, к Нам будет возвращение их;"}]},{"verse_key":"88:26","translations":[{"text":"Тогда нашим делом будет рассчитать их."}]}]