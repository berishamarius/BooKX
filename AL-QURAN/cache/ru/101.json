[{"verse_key":"101:1","translations":[{"text":"Поражающее -"}]},{"verse_key":"101:2","translations":[{"text":"Что такое поражающее?"}]},{"verse_key":"101:3","translations":[{"text":"О если бы кто вразумил тебя, что - это поражающее!"}]},{"verse_key":"101:4","translations":[{"text":"Это день, в который люди будут как бабочки разогнанные;"}]},{"verse_key":"101:5","translations":[{"text":"Горы будут как шерсть расщипанная."}]},{"verse_key":"101:6","translations":[{"text":"Тогда, на чьих весах будет тяжело,"}]},{"verse_key":"101:7","translations":[{"text":"тот будет в блаженной жизни;"}]},{"verse_key":"101:8","translations":[{"text":"А на чьих весах будет легко,"}]},{"verse_key":"101:9","translations":[{"text":"тому матерью будет безчадная преисподняя."}]},{"verse_key":"101:10","translations":[{"text":"О если бы кто вразумил тебя, о! Какова она!"}]},{"verse_key":"101:11","translations":[{"text":"Она - жгучий огонь."}]}]