[{"verse_key":"102:1","translations":[{"text":"Привязанность к богатству озабочивает вас"}]},{"verse_key":"102:2","translations":[{"text":"Дотоле, покуда не уходите гостить в могилах."}]},{"verse_key":"102:3","translations":[{"text":"Действительно, узнаете,"}]},{"verse_key":"102:4","translations":[{"text":"И еще, действительно, вы узнаете -"}]},{"verse_key":"102:5","translations":[{"text":"О если бы знали вы это теперь верным знанием -"}]},{"verse_key":"102:6","translations":[{"text":"Вы увидите пламень ада,"}]},{"verse_key":"102:7","translations":[{"text":"Увидите его очами уверенности."}]},{"verse_key":"102:8","translations":[{"text":"В тот день от вас спросят ответственности за привязанность к удовольствиям."}]}]