[{"verse_key":"81:1","translations":[{"text":"Когда солнце обовьется мраком,"}]},{"verse_key":"81:2","translations":[{"text":"Когда звезды померкнут;"}]},{"verse_key":"81:3","translations":[{"text":"Когда горы с мест своих сдвинутся,"}]},{"verse_key":"81:4","translations":[{"text":"Когда девять месяцев сужеребые верблюдицы окажутся праздными;"}]},{"verse_key":"81:5","translations":[{"text":"Когда звери столпятся,"}]},{"verse_key":"81:6","translations":[{"text":"когда моря закипят;"}]},{"verse_key":"81:7","translations":[{"text":"когда души сопрягутся,"}]},{"verse_key":"81:8","translations":[{"text":"когда похороненная живою будет спрошена:"}]},{"verse_key":"81:9","translations":[{"text":"за какой грех она убита?"}]},{"verse_key":"81:10","translations":[{"text":"Когда свитки разовьются,"}]},{"verse_key":"81:11","translations":[{"text":"Когда небо, как покров, снимется,"}]},{"verse_key":"81:12","translations":[{"text":"Когда ад разгорится,"}]},{"verse_key":"81:13","translations":[{"text":"И когда рай приблизится:"}]},{"verse_key":"81:14","translations":[{"text":"Тогда душа узнает, что заготовила она себе."}]},{"verse_key":"81:15","translations":[{"text":"Клянусь планетами,"}]},{"verse_key":"81:16","translations":[{"text":"Скрывающимися кометами;"}]},{"verse_key":"81:17","translations":[{"text":"Клянусь ночью, когда она темнеет,"}]},{"verse_key":"81:18","translations":[{"text":"Клянусь утром, когда оно прохладно веет:"}]},{"verse_key":"81:19","translations":[{"text":"Действительно, он - слово посланника, славного,"}]},{"verse_key":"81:20","translations":[{"text":"Сильного пред Властителем престола, полномочного,"}]},{"verse_key":"81:21","translations":[{"text":"Покорно чтимого, верного."}]},{"verse_key":"81:22","translations":[{"text":"И согражданин ваш не беснующийся:"}]},{"verse_key":"81:23","translations":[{"text":"Он некогда видел его на светлом небосклоне;"}]},{"verse_key":"81:24","translations":[{"text":"У него нет недоумения о таинственном."}]},{"verse_key":"81:25","translations":[{"text":"Он не есть слово сатаны, прогоняемого камнями."}]},{"verse_key":"81:26","translations":[{"text":"За чем же вы идете прочь?"}]},{"verse_key":"81:27","translations":[{"text":"Он - увещание мирам,"}]},{"verse_key":"81:28","translations":[{"text":"Тем из вас, которые хотят идти прямо."}]},{"verse_key":"81:29","translations":[{"text":"Но вы можете хотеть только того, чего хочет Бог, Господь миров."}]}]