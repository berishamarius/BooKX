[{"verse_key":"114:1","translations":[{"text":"Скажи: \"Ищу убежища у Господа людей,"}]},{"verse_key":"114:2","translations":[{"text":"Царя людей,"}]},{"verse_key":"114:3","translations":[{"text":"Бога людей,"}]},{"verse_key":"114:4","translations":[{"text":"от злобы скрытного искусителя,"}]},{"verse_key":"114:5","translations":[{"text":"Искушающего сердца людей,"}]},{"verse_key":"114:6","translations":[{"text":"От гениев и людей\"."}]}]