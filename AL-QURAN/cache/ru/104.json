[{"verse_key":"104:1","translations":[{"text":"Горе каждому хулителю, поносителю,"}]},{"verse_key":"104:2","translations":[{"text":"Который собирает имущество и копит его,"}]},{"verse_key":"104:3","translations":[{"text":"Думая, что его имущество увековечит его!"}]},{"verse_key":"104:4","translations":[{"text":"Нет, он ввержен будет в Хотаму."}]},{"verse_key":"104:5","translations":[{"text":"О если бы кто вразумил тебя, что такое Хотама!"}]},{"verse_key":"104:6","translations":[{"text":"Это - разженный огонь Божий,"}]},{"verse_key":"104:7","translations":[{"text":"Который взвивается вкруг сердец,"}]},{"verse_key":"104:8","translations":[{"text":"И над ними смыкается в свод"}]},{"verse_key":"104:9","translations":[{"text":"На высоких столбах."}]}]