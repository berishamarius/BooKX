[{"verse_key":"112:1","translations":[{"text":"Скажи: \"Он - Бог - един,"}]},{"verse_key":"112:2","translations":[{"text":"Крепкий Бог."}]},{"verse_key":"112:3","translations":[{"text":"Он не рождал и не рожден:"}]},{"verse_key":"112:4","translations":[{"text":"Равного Ему кого-либо не бывало\"."}]}]