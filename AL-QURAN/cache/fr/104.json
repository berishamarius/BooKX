[{"verse_key":"104:1","translations":[{"text":"Malheur à tout calomniateur diffamateur,"}]},{"verse_key":"104:2","translations":[{"text":"qui amasse une fortune et la compte,"}]},{"verse_key":"104:3","translations":[{"text":"pensant que sa fortune l'immortalisera."}]},{"verse_key":"104:4","translations":[{"text":"Mais non! Il sera certes, jeté dans la Hutamah."}]},{"verse_key":"104:5","translations":[{"text":"Et qui te dira ce qu'est la Hutamah?"}]},{"verse_key":"104:6","translations":[{"text":"Le Feu attisé d'Allah"}]},{"verse_key":"104:7","translations":[{"text":"qui monte jusqu'aux cœurs."}]},{"verse_key":"104:8","translations":[{"text":"Il se refermera sur eux,"}]},{"verse_key":"104:9","translations":[{"text":"en colonnes (de flammes) étendues."}]}]