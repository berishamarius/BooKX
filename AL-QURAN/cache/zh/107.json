[{"verse_key":"107:1","translations":[{"text":"你曾見否認報應日的人嗎？"}]},{"verse_key":"107:2","translations":[{"text":"他就是那個呵斥孤兒,"}]},{"verse_key":"107:3","translations":[{"text":"且不勉勵人賑濟貧民的人。"}]},{"verse_key":"107:4","translations":[{"text":"傷哉！禮拜的人們,"}]},{"verse_key":"107:5","translations":[{"text":"他們是忽視拜功的,"}]},{"verse_key":"107:6","translations":[{"text":"他們是沽名釣譽的,"}]},{"verse_key":"107:7","translations":[{"text":"他們是不肯借人什物的。"}]}]