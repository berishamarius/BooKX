[{"verse_key":"94:1","translations":[{"text":"難道我沒有為你而開拓你的胸襟嗎？"}]},{"verse_key":"94:2","translations":[{"text":"我卸下了你的重任"}]},{"verse_key":"94:3","translations":[{"text":"即使你的背擔負過重的，"}]},{"verse_key":"94:4","translations":[{"text":"而提高了你的聲望，"}]},{"verse_key":"94:5","translations":[{"text":"與艱難相伴的，確是容易，"}]},{"verse_key":"94:6","translations":[{"text":"與艱難相伴的，確是容易，"}]},{"verse_key":"94:7","translations":[{"text":"當你的事務完畢時，"}]},{"verse_key":"94:8","translations":[{"text":"你應當勤勞，你應當向你的主懇求。"}]}]