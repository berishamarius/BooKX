[{"verse_key":"114:1","translations":[{"text":"你說: 我求庇于世人的主宰,"}]},{"verse_key":"114:2","translations":[{"text":"世人的君王,"}]},{"verse_key":"114:3","translations":[{"text":"世人的神明,"}]},{"verse_key":"114:4","translations":[{"text":"免遭潛伏的教唆者的毒害,"}]},{"verse_key":"114:5","translations":[{"text":"他在世人的胸中教唆,"}]},{"verse_key":"114:6","translations":[{"text":"他是屬于精靈和人類的。"}]}]