[{"verse_key":"113:1","translations":[{"text":"你說: 我求庇于曙光的主,"}]},{"verse_key":"113:2","translations":[{"text":"免遭他所創造者的毒害;"}]},{"verse_key":"113:3","translations":[{"text":"免遭黑夜籠罩時的毒害;"}]},{"verse_key":"113:4","translations":[{"text":"免遭吹破堅決的主意者的毒害;"}]},{"verse_key":"113:5","translations":[{"text":"免遭嫉妒時的毒害。"}]}]