[{"verse_key":"95:1","translations":[{"text":"以無花果和橄欖果盟誓,"}]},{"verse_key":"95:2","translations":[{"text":"以西奈山盟誓,"}]},{"verse_key":"95:3","translations":[{"text":"以這個安寧的城市盟誓,"}]},{"verse_key":"95:4","translations":[{"text":"我確已把人造成具有最美的形態,"}]},{"verse_key":"95:5","translations":[{"text":"然后我使他變成最卑劣的;"}]},{"verse_key":"95:6","translations":[{"text":"但信道而且行善者, 將受不斷的報酬。"}]},{"verse_key":"95:7","translations":[{"text":"此后, 你怎麼還否認報應呢？"}]},{"verse_key":"95:8","translations":[{"text":"難道独一真神不是最公正的判決者嗎？"}]}]