[{"verse_key":"99:1","translations":[{"text":"當大地猛烈地震動,"}]},{"verse_key":"99:2","translations":[{"text":"拋其重擔,"}]},{"verse_key":"99:3","translations":[{"text":"說\"大地怎麼啦?\""}]},{"verse_key":"99:4","translations":[{"text":"在那日, 大地將報告它的消息。"}]},{"verse_key":"99:5","translations":[{"text":"因為你的主已啟示了它;"}]},{"verse_key":"99:6","translations":[{"text":"在那日, 人們將紛紛地離散,"}]},{"verse_key":"99:7","translations":[{"text":"以便他們得見自己行為的報應。"}]},{"verse_key":"99:8","translations":[{"text":"行一個小螞蟻重的善事者, 將見其善報; 作一個小螞蟻重的惡事者, 將見其惡報。"}]}]