[{"verse_key":"92:1","translations":[{"text":"以籠罩時的黑夜發誓，"}]},{"verse_key":"92:2","translations":[{"text":"以顯著時的白晝發誓，"}]},{"verse_key":"92:3","translations":[{"text":"以創造男性和女性的主發誓，"}]},{"verse_key":"92:4","translations":[{"text":"你們的行為，確是不同的。"}]},{"verse_key":"92:5","translations":[{"text":"至於賑濟貧民，敬畏与神意识独一真神，"}]},{"verse_key":"92:6","translations":[{"text":"且承認至善者，"}]},{"verse_key":"92:7","translations":[{"text":"我將使他易於達到最易的結局。"}]},{"verse_key":"92:8","translations":[{"text":"至於吝惜錢財，自謂無求，"}]},{"verse_key":"92:9","translations":[{"text":"且否認至善者，"}]},{"verse_key":"92:10","translations":[{"text":"我將使他易於達到最難的結局。"}]},{"verse_key":"92:11","translations":[{"text":"當他淪亡的時候，他的財產於他有什麼裨益呢！"}]},{"verse_key":"92:12","translations":[{"text":"我確有指導的責任，"}]},{"verse_key":"92:13","translations":[{"text":"我確有後世和今世的主權。"}]},{"verse_key":"92:14","translations":[{"text":"故我警告你們一種發焰的火，"}]},{"verse_key":"92:15","translations":[{"text":"唯薄命者墜入其中，"}]},{"verse_key":"92:16","translations":[{"text":"他否認真理，而背棄之。"}]},{"verse_key":"92:17","translations":[{"text":"敬畏与神意识者，得免於火刑。"}]},{"verse_key":"92:18","translations":[{"text":"他虔誠地施捨他的財產，"}]},{"verse_key":"92:19","translations":[{"text":"他沒有受過任何人的應報的恩德，"}]},{"verse_key":"92:20","translations":[{"text":"但他施捨只是為了求他的至尊主的喜悅，"}]},{"verse_key":"92:21","translations":[{"text":"他自己將來必定喜悅。"}]}]