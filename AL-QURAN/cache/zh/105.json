[{"verse_key":"105:1","translations":[{"text":"難道你不知道你的主怎樣處治象的主人們嗎？"}]},{"verse_key":"105:2","translations":[{"text":"難道他沒有使他們的計謀, 變成無益的嗎？"}]},{"verse_key":"105:3","translations":[{"text":"他曾派遣成群的鳥去傷他們,"}]},{"verse_key":"105:4","translations":[{"text":"以粘土石射擊他們,"}]},{"verse_key":"105:5","translations":[{"text":"使他們變成吃剩的乾草一樣。"}]}]