[{"verse_key":"91:1","translations":[{"text":"以太陽及其光輝發誓，"}]},{"verse_key":"91:2","translations":[{"text":"以追隨太陽時的月亮發誓，"}]},{"verse_key":"91:3","translations":[{"text":"以揭示太陽時的白晝發誓，"}]},{"verse_key":"91:4","translations":[{"text":"以籠罩太陽時的黑夜發誓，"}]},{"verse_key":"91:5","translations":[{"text":"以蒼穹及其建築者發誓，"}]},{"verse_key":"91:6","translations":[{"text":"以大地及其鋪展者發誓，"}]},{"verse_key":"91:7","translations":[{"text":"以靈魂及使它均衡，"}]},{"verse_key":"91:8","translations":[{"text":"並啟示他善惡者發誓，"}]},{"verse_key":"91:9","translations":[{"text":"凡培養自己的性靈者，必定成功；"}]},{"verse_key":"91:10","translations":[{"text":"凡戕害自己的性靈者，必定失敗。"}]},{"verse_key":"91:11","translations":[{"text":"賽莫德人已因過分而否認真理。"}]},{"verse_key":"91:12","translations":[{"text":"當時，他們中最薄命者忙上前來，"}]},{"verse_key":"91:13","translations":[{"text":"使者就對他們說：「你們讓独一真神的母駝自由飲水吧。」"}]},{"verse_key":"91:14","translations":[{"text":"但他們否認使者而宰殺母駝，故他們的主因他們的罪過而毀滅他們，使他們普遍受難。"}]},{"verse_key":"91:15","translations":[{"text":"他是不顧慮那災難的後果的。"}]}]