[{"verse_key":"109:1","translations":[{"text":"你說:\"不信道的人們啊！"}]},{"verse_key":"109:2","translations":[{"text":"我不崇拜你們所崇拜的,"}]},{"verse_key":"109:3","translations":[{"text":"你們也不崇拜我所崇拜的;"}]},{"verse_key":"109:4","translations":[{"text":"我不會崇拜你們所崇拜的,"}]},{"verse_key":"109:5","translations":[{"text":"你們也不會崇拜我所崇拜的;"}]},{"verse_key":"109:6","translations":[{"text":"你們有你們的報應, 我也有我的報應。\""}]}]