[{"verse_key":"111:1","translations":[{"text":"願焰父兩手受傷！他必定受傷,"}]},{"verse_key":"111:2","translations":[{"text":"他的財產, 和他所獲得的, 將無裨于他,"}]},{"verse_key":"111:3","translations":[{"text":"他將入有焰的烈火,"}]},{"verse_key":"111:4","translations":[{"text":"他的擔柴的妻子, 也將入烈火,"}]},{"verse_key":"111:5","translations":[{"text":"她的頸上繫著一條堅實的繩子。"}]}]