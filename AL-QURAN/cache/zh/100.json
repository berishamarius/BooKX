[{"verse_key":"100:1","translations":[{"text":"以喘息而奔馳的馬隊盟誓,"}]},{"verse_key":"100:2","translations":[{"text":"以蹄發火花的馬隊盟誓,"}]},{"verse_key":"100:3","translations":[{"text":"以早晨出擊,"}]},{"verse_key":"100:4","translations":[{"text":"捲起塵埃,"}]},{"verse_key":"100:5","translations":[{"text":"攻入敵圍的馬隊盟誓,"}]},{"verse_key":"100:6","translations":[{"text":"人對于主, 確是孤負的。"}]},{"verse_key":"100:7","translations":[{"text":"他自己對那孤負確是見証的,"}]},{"verse_key":"100:8","translations":[{"text":"他對于財產確是酷好的。"}]},{"verse_key":"100:9","translations":[{"text":"難道他不知道嗎？當墳中的朽骨被揭發,"}]},{"verse_key":"100:10","translations":[{"text":"胸中的秘密被顯示的時侯,"}]},{"verse_key":"100:11","translations":[{"text":"在那日, 他們的主, 確是徹知他們的。"}]}]