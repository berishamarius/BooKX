[{"verse_key":"101:1","translations":[{"text":"大難,"}]},{"verse_key":"101:2","translations":[{"text":"大難是什麼？"}]},{"verse_key":"101:3","translations":[{"text":"你怎能知道大難是什麼？"}]},{"verse_key":"101:4","translations":[{"text":"在那日, 眾人將似分散的飛蛾,"}]},{"verse_key":"101:5","translations":[{"text":"山岳將似疏松的釆絨。"}]},{"verse_key":"101:6","translations":[{"text":"至於善功的份量較重者,"}]},{"verse_key":"101:7","translations":[{"text":"將在滿意的生活中;"}]},{"verse_key":"101:8","translations":[{"text":"至於善功的份量較輕者,"}]},{"verse_key":"101:9","translations":[{"text":"他的歸宿是深坑。"}]},{"verse_key":"101:10","translations":[{"text":"你怎能知道深坑裏有什麼？"}]},{"verse_key":"101:11","translations":[{"text":"有烈火。"}]}]