[{"verse_key":"102:1","translations":[{"text":"競賽富庶, 已使你們疏忽,"}]},{"verse_key":"102:2","translations":[{"text":"直到你們去遊墳地。"}]},{"verse_key":"102:3","translations":[{"text":"真的, 你們將來就知道了。"}]},{"verse_key":"102:4","translations":[{"text":"真的, 你們將來就知道了。"}]},{"verse_key":"102:5","translations":[{"text":"真的, 假若你們有真知灼見, (你們必不疏忽),"}]},{"verse_key":"102:6","translations":[{"text":"你們必定看見火獄,"}]},{"verse_key":"102:7","translations":[{"text":"然後, 你們必親眼看見它。"}]},{"verse_key":"102:8","translations":[{"text":"在那日, 你們必為恩澤而被審問。"}]}]