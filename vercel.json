{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/quran", "destination": "/dist-alquran/cover.html" },
    { "source": "/quran/(.*)", "destination": "/dist-alquran/$1" },
    { "source": "/bibel", "destination": "/dist-diebibel/cover.html" },
    { "source": "/bibel/(.*)", "destination": "/dist-diebibel/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
